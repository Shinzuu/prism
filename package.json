{
  "name": "prism",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prebuild": "node -e \"const f=require('node:fs');f.writeFileSync('public/tokens-preview.css',f.readFileSync('src/styles/tokens.css','utf8')+f.readFileSync('src/styles/scale.css','utf8'))\" && node scripts/gen-imports.mjs",
    "predev": "node -e \"const f=require('node:fs');f.writeFileSync('public/tokens-preview.css',f.readFileSync('src/styles/tokens.css','utf8')+f.readFileSync('src/styles/scale.css','utf8'))\" && node scripts/gen-imports.mjs",
    "qa": "node test/qa.mjs",
    "verify": "npm run build && node test/run.mjs && node test/library.mjs && node test/motion.mjs && node test/all.mjs && node test/contrast.mjs && node test/qa.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@formkit/auto-animate": "^0.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "gsap": "^3.15.0",
    "motion": "^13.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.13.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
