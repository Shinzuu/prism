---
import '../styles/tokens.css';
import '../styles/scale.css';
const { title, wide = false, description = 'Thirty components that read their palette out of an image.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · prism</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <!-- Self-hosted, latin subset only. Google Fonts cost 1.8MB across this page
       because each preview frame re-requested the stylesheet and the faces. -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/BricolageGrotesque-700_800.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/IBMPlexSans-400.woff2" crossorigin />
  <link rel="stylesheet" href="/fonts/fonts.css" />
  <script is:inline src="/theme.js"></script>
</head>
<body class={wide ? "wide" : ""}>
  <header class="mast">
    <a class="mast__id" href="/">prism</a>
    <nav class="mast__nav">
      <a href="/">Index</a>
      <a href="/about">Method</a>
      <a href="https://github.com/Shinzuu/prism">Source</a>
    </nav>
  </header>

  <main><slot /></main>

  <footer class="colo">
    <p>Two components a week for ninety days. Each one keeps the prompt that produced it.</p>
    <p class="colo__set">Set in IBM Plex. Palette derived in OKLab, lightness held on a fixed ladder.</p>
  </footer>

  <script is:inline>
  </script>

  <script>
    import '../scripts/motion.js';
  </script>

  <style is:global>
    :root { --well: 1180px; --gutter: var(--s-l); }
    body.wide { --well: 1320px; }
    html { scroll-padding-block-start: calc(var(--s-2xl) + var(--s-s)); }
    /* Nothing may widen the document. A single overflowing decoration makes a
       phone zoom the whole page out, which reads as a broken layout. */
    body { overflow-x: clip; }

    .mast {
      position: sticky; top: 0; z-index: 40;
      display: flex; align-items: center; gap: var(--s-s); flex-wrap: wrap;
      max-width: var(--well); margin: 0 auto; padding: var(--s-s) var(--gutter);
      background: var(--bg);
      border-bottom: var(--rule);
    }
    .mast__id { font-family: var(--serif); font-size: var(--f-1); font-weight: 600; letter-spacing: var(--tr-head); text-decoration: none; }
    .mast__nav { display: flex; gap: 2px; margin-left: auto; font-size: var(--f-n1); min-width: 0; }
    .mast__nav a {
      color: var(--text-dim); text-decoration: none; white-space: nowrap;
      padding: 6px 10px; border-radius: 999px;
      transition: color 160ms ease, background 160ms ease;
    }
    .mast__nav a:hover { color: var(--text); background: color-mix(in oklab, var(--text) 8%, transparent); }

    
    
    
    
    
    

    .rig__read { display: flex; flex-wrap: wrap; align-items: center; gap: 0 var(--s-m); margin: 0; }
    .rig__read dt { width: 11px; height: 11px; border: var(--rule); border-radius: 2px; }
    .rig__read dd { margin: 0 0 0 var(--s-3xs); display: flex; gap: var(--s-3xs); align-items: baseline; }
    .rig__read b { font-weight: 450; font-size: var(--f-n2); }
    .rig__read span { font-family: var(--mono); font-size: var(--f-n2); color: var(--text-dim); }

    main { max-width: var(--well); margin: 0 auto; padding: 0 var(--gutter) var(--s-3xl); }

    /* A narrow phone is a real device, not an edge case. Tighten the gutter and
       let the masthead give up its padding before the document widens. */
    @media (max-width: 400px) {
      :root { --gutter: var(--s-s); }
      .mast { gap: var(--s-2xs); padding-inline: var(--s-s); }
      .mast__nav a { padding: 5px 7px; }
      .mast__id { font-size: var(--f-0); }
    }

    .colo {
      max-width: var(--well); margin: var(--s-2xl) auto 0; padding: var(--s-l) var(--gutter) var(--s-2xl);
      border-top: var(--rule); color: var(--text-dim); font-size: var(--f-n1);
    }
    .colo p { max-width: var(--measure); }
    .colo__set { margin-top: var(--s-3xs); font-family: var(--mono); font-size: var(--f-n2); }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
    }
  </style>
</body>
</html>
