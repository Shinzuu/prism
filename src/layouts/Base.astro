---
import '../styles/tokens.css';
import '../styles/scale.css';
const { title, description = 'Thirty components that read their palette out of an image.' } = Astro.props;
const wallpapers = ['dusk', 'forest', 'ember', 'ice', 'sand'];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · prism</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;450;500;600&family=IBM+Plex+Serif:ital,wght@0,400;0,600;1,400&display=swap" />
  <script is:inline src="/theme.js"></script>
  <script is:inline defer src="/scope.js"></script>
</head>
<body>
  <header class="mast">
    <a class="mast__id" href="/">prism</a>
    <nav class="mast__nav">
      <a href="/">Index</a>
      <a href="/about">Method</a>
      <a href="https://github.com/Shinzuu/prism">Source</a>
    </nav>
  </header>

  <div class="rig">
    <div class="rig__chips">
      {wallpapers.map((w) => (
        <button class="chip" type="button" data-wall={`/wallpapers/${w}.svg`}>
          <img src={`/wallpapers/${w}.svg`} alt="" width="40" height="26" loading="lazy" />
          {w}
        </button>
      ))}
      <label class="chip">
        <input type="file" accept="image/*" hidden id="wall-upload" />
        <span class="chip__box" aria-hidden="true">＋</span>your image
      </label>
      <button class="chip" type="button" id="mode-toggle">
        <span class="chip__box" aria-hidden="true">◐</span><span id="mode-name">invert</span>
      </button>
    </div>
    <dl class="rig__read" id="readout" aria-label="Computed palette"></dl>
  </div>

  {Astro.props.scope && (
    <section class="scope" aria-label="How this palette was derived">
      <div class="scope__panel">
        <h2 class="scope__h">Hue, as measured</h2>
        <p class="scope__p">Every pixel converted to OKLab, greys discarded, the rest collected into thirty-six bins weighted by chroma. Tallest bin sets the page. The tallest at least sixty degrees away sets the accent.</p>
        <div class="scope__hist" id="scope-hist" role="img" aria-label="Hue distribution of the current image"></div>
      </div>
      <div class="scope__panel">
        <h2 class="scope__h">Contrast, as measured</h2>
        <p class="scope__p">Recomputed from the live palette on every change. Lightness is fixed, so these hold for any image — which is the whole reason lightness never comes from the picture.</p>
        <div class="scope__grid" id="scope-contrast"></div>
      </div>
    </section>
  )}

  <main><slot /></main>

  <footer class="colo">
    <p>Two components a week for ninety days. Each one keeps the prompt that produced it.</p>
    <p class="colo__set">Set in IBM Plex. Palette derived in OKLab, lightness held on a fixed ladder.</p>
  </footer>

  <script is:inline>
    document.querySelectorAll('[data-wall]').forEach((b) =>
      b.addEventListener('click', () => window.prism.fromImage(b.dataset.wall)));
    document.getElementById('mode-toggle')?.addEventListener('click', () => window.prism.toggleMode());
    document.getElementById('wall-upload')?.addEventListener('change', (e) => {
      const f = e.target.files?.[0];
      if (!f) return;
      const url = URL.createObjectURL(f);
      window.prism.fromImage(url).finally(() => URL.revokeObjectURL(url));
    });

    const SHOWN = [['--bg','page'],['--surface','field'],['--border','rule'],['--text','ink'],['--accent','accent']];
    function paintReadout() {
      const cs = getComputedStyle(document.documentElement);
      const dl = document.getElementById('readout');
      if (!dl) return;
      dl.textContent = '';
      for (const [tok, label] of SHOWN) {
        const dt = document.createElement('dt');
        dt.style.background = `var(${tok})`;
        const dd = document.createElement('dd');
        const b = document.createElement('b'); b.textContent = label;
        const s = document.createElement('span'); s.textContent = cs.getPropertyValue(tok).trim();
        dd.append(b, s);
        dl.append(dt, dd);
      }
    }
    addEventListener('prism:theme', paintReadout);
    addEventListener('DOMContentLoaded', paintReadout);
  </script>

  <style is:global>
    :root { --well: 1120px; --gutter: var(--s-l); }

    .mast {
      display: flex; align-items: baseline; gap: var(--s-m);
      max-width: var(--well); margin: 0 auto; padding: var(--s-m) var(--gutter) var(--s-s);
    }
    .mast__id { font-family: var(--serif); font-size: var(--f-1); font-weight: 600; letter-spacing: var(--tr-head); text-decoration: none; }
    .mast__nav { display: flex; gap: var(--s-s); margin-left: auto; font-size: var(--f-n1); }
    .mast__nav a { color: var(--text-dim); text-decoration: none; }
    .mast__nav a:hover { color: var(--accent); }

    .rig {
      max-width: var(--well); margin: 0 auto var(--s-xl);
      padding: var(--s-xs) var(--gutter);
      border-top: var(--rule); border-bottom: var(--rule);
      display: grid; gap: var(--s-2xs);
    }
    .rig__chips { display: flex; flex-wrap: wrap; gap: var(--s-3xs); }
    .chip {
      display: inline-flex; align-items: center; gap: var(--s-3xs);
      padding: var(--s-3xs) var(--s-2xs) var(--s-3xs) var(--s-3xs); cursor: pointer;
      background: transparent; color: var(--text-dim);
      border: var(--rule); border-radius: var(--radius);
      font-family: var(--mono); font-size: var(--f-n2); letter-spacing: var(--tr-mono);
    }
    .chip:hover { color: var(--text); border-color: var(--accent); }
    .chip img, .chip__box { display: block; width: 40px; height: 26px; border-radius: 1px; object-fit: cover; }
    .chip__box { display: grid; place-items: center; background: var(--surface); }

    .rig__read { display: flex; flex-wrap: wrap; align-items: center; gap: 0 var(--s-m); margin: 0; }
    .rig__read dt { width: 11px; height: 11px; border: var(--rule); border-radius: 2px; }
    .rig__read dd { margin: 0 0 0 var(--s-3xs); display: flex; gap: var(--s-3xs); align-items: baseline; }
    .rig__read b { font-weight: 450; font-size: var(--f-n2); }
    .rig__read span { font-family: var(--mono); font-size: var(--f-n2); color: var(--text-dim); }

    main { max-width: var(--well); margin: 0 auto; padding: 0 var(--gutter) var(--s-3xl); }

    .scope {
      max-width: var(--well); margin: 0 auto var(--s-xl); padding: 0 var(--gutter);
      display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-l);
    }
    .scope__h { font-size: var(--f-0); font-family: var(--sans); font-weight: 500; letter-spacing: 0; }
    .scope__p { margin-top: var(--s-3xs); font-size: var(--f-n2); line-height: 1.5; color: var(--text-dim); max-width: 48ch; }

    .scope__hist {
      display: flex; align-items: flex-end; gap: 2px;
      height: 76px; margin-top: var(--s-xs);
      padding: var(--s-3xs); border: var(--rule); border-radius: var(--radius);
    }
    .scope__bar { flex: 1; border-radius: 1px 1px 0 0; position: relative; }
    .scope__bar[data-mark]::after {
      content: attr(data-mark); position: absolute; top: -13px; left: 50%;
      translate: -50% 0; font-family: var(--mono); font-size: 9px; color: var(--text-dim);
    }
    .scope__bar[data-mark] { outline: 1px solid var(--text); outline-offset: 1px; }

    .scope__grid { margin-top: var(--s-xs); display: grid; gap: 1px; }
    .scope__row { display: grid; grid-template-columns: 2.6em 1fr auto; gap: var(--s-2xs); align-items: center; }
    .scope__pair {
      display: grid; place-items: center; height: 21px;
      border: var(--rule); border-radius: 2px;
      font-size: var(--f-n2); font-family: var(--serif);
    }
    .scope__name { font-size: var(--f-n2); color: var(--text-dim); }
    .scope__val { font-family: var(--mono); font-size: var(--f-n2); }
    .scope__row[data-pass="false"] .scope__val { color: oklch(56% 0.2 25); }

    @media (max-width: 720px) { .scope { grid-template-columns: 1fr; gap: var(--s-m); } }

    .colo {
      max-width: var(--well); margin: 0 auto; padding: var(--s-m) var(--gutter) var(--s-2xl);
      border-top: var(--rule); color: var(--text-dim); font-size: var(--f-n1);
    }
    .colo p { max-width: var(--measure); }
    .colo__set { margin-top: var(--s-3xs); font-family: var(--mono); font-size: var(--f-n2); }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
    }
  </style>
</body>
</html>
