---
import '../styles/tokens.css';
const { title, description = 'Thirty components that take their palette from an image.' } = Astro.props;
const wallpapers = ['dusk', 'forest', 'ember', 'ice', 'sand'];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · prism</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;450;500;600&family=IBM+Plex+Serif:ital,wght@0,400;0,600;1,400&display=swap" />
  <script is:inline src="/theme.js"></script>
</head>
<body>
  <header class="masthead">
    <a class="masthead__id" href="/">prism</a>
    <nav class="masthead__nav">
      <a href="/">Index</a>
      <a href="/about">Method</a>
      <a href="https://github.com/Shinzuu/prism">Source</a>
    </nav>
  </header>

  <div class="instrument">
    <div class="instrument__picker">
      {wallpapers.map((w) => (
        <button class="chip" type="button" data-wall={`/wallpapers/${w}.svg`}>
          <img src={`/wallpapers/${w}.svg`} alt="" width="44" height="28" loading="lazy" />
          <span class="chip__name">{w}</span>
        </button>
      ))}
      <label class="chip chip--file">
        <input type="file" accept="image/*" hidden id="wall-upload" />
        <span class="chip__plus" aria-hidden="true">＋</span>
        <span class="chip__name">your image</span>
      </label>
      <button class="chip chip--mode" type="button" id="mode-toggle">
        <span class="chip__plus" aria-hidden="true">◐</span>
        <span class="chip__name" id="mode-name">dark</span>
      </button>
    </div>
    <dl class="readout" id="readout" aria-label="Current palette values"></dl>
  </div>

  <main><slot /></main>

  <footer class="colophon">
    <p>Built for a ninety-day challenge. Two components a week, thirty in total, each one recorded with the prompt that produced it.</p>
    <p class="colophon__meta">Set in IBM Plex. Palette derived in OKLab.</p>
  </footer>

  <script is:inline>
    document.querySelectorAll('[data-wall]').forEach((b) =>
      b.addEventListener('click', () => window.prism.fromImage(b.dataset.wall)));

    document.getElementById('mode-toggle')?.addEventListener('click', () => {
      const next = window.prism.toggleMode();
      document.getElementById('mode-name').textContent = next === 'dark' ? 'light' : 'dark';
    });

    document.getElementById('wall-upload')?.addEventListener('change', (e) => {
      const f = e.target.files?.[0];
      if (!f) return;
      const url = URL.createObjectURL(f);
      window.prism.fromImage(url).finally(() => URL.revokeObjectURL(url));
    });

    // The readout is the point of the whole site: show the palette it computed.
    const SHOWN = [['--bg','page'],['--surface','field'],['--border','rule'],
                   ['--text','ink'],['--accent','accent']];
    function paintReadout() {
      const cs = getComputedStyle(document.documentElement);
      const dl = document.getElementById('readout');
      if (!dl) return;
      dl.textContent = '';
      for (const [tok, label] of SHOWN) {
        const dt = document.createElement('dt');
        dt.className = 'readout__swatch';
        dt.style.background = `var(${tok})`;
        const dd = document.createElement('dd');
        dd.className = 'readout__val';
        dd.innerHTML = `<b>${label}</b><span>${cs.getPropertyValue(tok).trim()}</span>`;
        dl.append(dt, dd);
      }
    }
    addEventListener('prism:theme', paintReadout);
    addEventListener('DOMContentLoaded', paintReadout);
  </script>

  <style is:global>
    main { max-width: 1120px; margin: 0 auto; padding: 0 28px 96px; }

    .masthead {
      display: flex; align-items: baseline; gap: 26px;
      max-width: 1120px; margin: 0 auto; padding: 22px 28px 16px;
    }
    .masthead__id {
      font-family: var(--serif); font-size: 21px; font-weight: 600;
      letter-spacing: -0.02em; text-decoration: none;
    }
    .masthead__nav { display: flex; gap: 18px; margin-left: auto; font-size: 14px; }
    .masthead__nav a { color: var(--text-dim); text-decoration: none; }
    .masthead__nav a:hover { color: var(--accent); }

    .instrument {
      max-width: 1120px; margin: 0 auto 40px; padding: 0 28px;
      display: grid; gap: 14px;
      border-top: var(--rule); border-bottom: var(--rule);
      padding-block: 16px;
    }
    .instrument__picker { display: flex; flex-wrap: wrap; gap: 8px; }

    .chip {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 5px 10px 5px 5px; cursor: pointer;
      background: transparent; color: var(--text-dim);
      border: var(--rule); border-radius: var(--radius);
      font: inherit; font-size: 13px;
    }
    .chip:hover { color: var(--text); border-color: var(--accent); }
    .chip img { display: block; width: 44px; height: 28px; object-fit: cover; border-radius: 1px; }
    .chip__plus {
      width: 44px; height: 28px; display: grid; place-items: center;
      background: var(--surface); border-radius: 1px; font-size: 13px;
    }
    .chip__name { font-family: var(--mono); font-size: 11.5px; }

    .readout { display: flex; flex-wrap: wrap; gap: 0 22px; margin: 0; align-items: center; }
    .readout__swatch {
      width: 13px; height: 13px; margin-right: -14px;
      border: var(--rule); border-radius: 2px;
    }
    .readout__val { margin: 0 0 0 22px; display: flex; gap: 7px; align-items: baseline; }
    .readout__val b { font-weight: 500; font-size: 12px; }
    .readout__val span { font-family: var(--mono); font-size: 10.5px; color: var(--text-dim); }

    .colophon {
      max-width: 1120px; margin: 0 auto; padding: 22px 28px 56px;
      border-top: var(--rule); color: var(--text-dim); font-size: 13.5px;
    }
    .colophon p { margin: 0 0 6px; max-width: var(--measure); }
    .colophon__meta { font-family: var(--mono); font-size: 11.5px; }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
    }
  </style>
</body>
</html>
