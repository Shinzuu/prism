---
import Base from '../../layouts/Base.astro';
import PageNav from '../../components/PageNav.astro';
import { allComponents } from '../../lib/registry.js';

export async function getStaticPaths() {
  const all = allComponents();
  return all.map((c, i) => ({
    params: { slug: c.slug },
    props: { c, prev: all[i - 1] ?? null, next: all[i + 1] ?? null }
  }));
}
const { c, prev, next } = Astro.props;
const repo = `https://github.com/Shinzuu/prism/blob/main/${c.repoPath}`;
const site = 'https://prism.shinzuu-dev.workers.dev';
const files = [
  /* React components publish their .tsx. style.css survives only where Tailwind
     genuinely cannot reach — @property registration, keyframes, scroll
     timelines, @font-face — so it is shown only when it exists. */
  ...(c.hasTsx ? [{ label: 'Component.tsx', lang: 'tsx', body: c.tsx }] : [{ label: 'index.html', lang: 'html', body: c.html }]),
  ...(c.css ? [{ label: 'style.css', lang: 'css', body: c.css }] : []),
  ...(!c.hasTsx && c.js ? [{ label: 'script.js', lang: 'js', body: c.js }] : [])
];
---
<Base title={c.name} description={c.summary}>
  <article class="doc" data-wb>
    <PageNav
      back={`/#${c.type}`}
      backLabel="Library"
      crumbs={[c.type, `week ${c.week}`]}
      prev={prev ? { href: `/components/${prev.slug}`, label: prev.name } : null}
      next={next ? { href: `/components/${next.slug}`, label: next.name } : null}
    />

    <header class="doc__head">
      <h1>{c.name}</h1>
      <p class="doc__sum">{c.summary}</p>
      <p class="doc__meta"><span>{c.type}</span><span>week {c.week}</span><a href={repo}>source</a></p>

      <div class="use" data-use>
        <p class="use__lab">Element ID</p>
        <p class="use__row">
          <code class="use__id" data-use-id>{c.slug}</code>
          <button class="link" type="button" data-use-copy={`Use the "${c.slug}" element from ${site}/components/${c.slug}`}>copy reference</button>
        </p>
        <p class="use__hint">Ask for it by ID: <em>use the <code>{c.slug}</code> element</em>. The
          full source and props are at <code>/elements/{c.slug}.json</code>.</p>
      </div>
    </header>

    <figure class="stage">
      <div class="stage__wrap" data-wb-wrap>
        {/* The frame loads the BUILT preview. The old workbench assembled a
            document from html/css/js panes, which stopped existing when the
            components became .tsx — it was handing the iframe an empty body,
            so every detail page showed a blank stage. TSX cannot be compiled
            in the browser, so the built route is the only honest source. */}
        <iframe class="stage__frame" data-wb-frame src={`/preview/${c.slug}`}
          title={`${c.name}, running`} loading="lazy" sandbox="allow-scripts"></iframe>
      </div>
      <figcaption class="stage__bar">
        <span data-wb-status data-state="ok">live</span>
        <span class="rig" data-wb-rig>
          <button type="button" data-w="360" aria-pressed="false">360</button>
          <button type="button" data-w="768" aria-pressed="false">768</button>
          <button type="button" data-w="full" aria-pressed="true">full</button>
        </span>
        <a class="link" href={`/preview/${c.slug}`} target="_blank" rel="noopener">open alone</a>
      </figcaption>
    </figure>

    <section class="src">
      <div class="src__tabs">
        {/* The copy button used to sit inside the tablist, which is only
            allowed to contain tabs. */}
        <div class="src__tablist" role="tablist" aria-label="Files">
          {files.map((f, i) => (
            <button class="src__tab" type="button" role="tab" data-wb-tab={f.lang}
              aria-selected={i === 0 ? 'true' : 'false'}>{f.label}</button>
          ))}
        </div>
        <button class="link link--end" type="button" data-wb-copy>copy</button>
      </div>
      {files.map((f, i) => (
        <textarea class="src__text" data-wb-pane={f.lang} hidden={i !== 0} readonly
          spellcheck="false" aria-label={f.label} rows="20">{f.body}</textarea>
      ))}
      <p class="src__note">Read-only. Copy it into a React + Tailwind project as-is.</p>
    </section>

    <section class="say">
      <h2>The prompt</h2>
      <pre class="quote">{c.finalPrompt}</pre>
    </section>

    {c.attempts.length > 0 && (
      <section class="say">
        <h2>What came before it</h2>
        {c.attempts.map((a, i) => (
          <div class="try">
            <p class="try__n">Attempt {i + 1}</p>
            <pre class="quote quote--muted">{a.prompt}</pre>
            <p class="try__why">{a.problem}</p>
          </div>
        ))}
      </section>
    )}

    {c.why && (
      <section class="say">
        <h2>Why the last one worked</h2>
        {c.why.split('\n\n').map((p) => <p class="say__p">{p}</p>)}
      </section>
    )}

    <nav class="jump">
      {prev ? <a href={`/components/${prev.slug}`}><span>previous</span>{prev.name}</a> : <span></span>}
      {next ? <a class="jump__next" href={`/components/${next.slug}`}><span>next</span>{next.name}</a> : <span></span>}
    </nav>
  </article>
</Base>

<script is:inline src="/workbench.js"></script>

<style>
  /* Bleed. Prose keeps a 66ch measure; the specimen and its source break the
     column and run the full well, so looking and reading stay distinct. */
  .doc {
    display: grid;
    grid-template-columns:
      [wide-start] minmax(0, 1fr)
      [text-start] min(var(--measure), 100%) [text-end]
      minmax(0, 1fr) [wide-end];
    row-gap: var(--s-m);
  }
  .doc > * { grid-column: text; }
  /* PageNav is a separate component, so it carries its own scope attribute and
     `.doc > *` — which Astro scopes to this page's own elements — never matched
     it. The breadcrumb was being placed in column one, the bleed margin, which
     is zero wide on a phone: it collapsed to nothing and the header painted
     over the top of it. Nothing about it looked broken in the markup. */
  .doc > :global(.pnav) { grid-column: text; }

  .doc__head h1 { font-size: var(--f-4); }
  .doc__sum { margin-top: var(--s-2xs); font-size: var(--f-1); line-height: var(--lh-lead); color: var(--text-dim); }
  .doc__meta { display: flex; gap: var(--s-s); margin-top: var(--s-2xs); font-family: var(--mono); font-size: var(--f-n2); color: var(--text-dim); }
  .doc__meta a { color: var(--text-dim); }
  .doc__meta a:hover { color: var(--accent); }

  /* The element id is the one thing on this page a model is told to quote, so
     it gets a frame of its own rather than sitting in the run of the header. */
  .use {
    margin-top: var(--s-s);
    padding: var(--s-2xs) var(--s-s);
    border-inline-start: 2px solid var(--accent);
    background: color-mix(in oklab, var(--accent) 5%, transparent);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .use__lab {
    margin: 0;
    font-family: var(--mono); font-size: var(--f-n2);
    letter-spacing: .06em; color: var(--text-dim);
  }
  .use__row { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s-2xs); margin: 2px 0 0; }
  .use__id { font-family: var(--mono); font-size: var(--f-1); color: var(--text); }
  .use__hint { margin: var(--s-3xs) 0 0; font-size: var(--f-n1); color: var(--text-dim); }
  .use__hint code { font-family: var(--mono); color: var(--text); }
  .use__hint em { font-style: normal; color: var(--text); }

  .stage, .src { grid-column: wide; }
  .stage { margin: var(--s-s) 0 0; border: var(--rule); border-radius: var(--radius); overflow: hidden; }
  .stage__wrap { margin: 0 auto; transition: max-width 220ms cubic-bezier(.2,.7,.3,1); }
  .stage__wrap[data-narrow="true"] { border-inline: var(--rule); }
  .stage__frame { display: block; width: 100%; height: clamp(240px, 34vh, 380px); border: 0; background: var(--bg); }

  .rig { display: inline-flex; gap: 2px; margin-left: var(--s-2xs); }
  .rig button {
    padding: 2px 7px; cursor: pointer; background: var(--bg);
    border: var(--rule); border-radius: var(--radius);
    font-family: var(--mono); font-size: var(--f-n2); color: var(--text-dim);
  }
  .rig button[aria-pressed="true"] { color: var(--accent-fg); background: var(--accent); border-color: var(--accent); }
  .stage__bar {
    display: flex; align-items: center; gap: var(--s-s);
    padding: var(--s-3xs) var(--s-xs); border-top: var(--rule); background: var(--surface);
    font-family: var(--mono); font-size: var(--f-n2); color: var(--text-dim);
  }
  /* Accent ink on the bar's own surface measured 4.35:1 at 11px. The word
     carries full contrast and the accent moves to a dot, which is a graphic and
     clears its own 3:1 floor. */
  .stage__bar [data-state="ok"] { color: var(--text); }
  .stage__bar [data-state="ok"]::before {
    content: ""; display: inline-block; vertical-align: 1px;
    width: 7px; height: 7px; margin-right: 5px; border-radius: 999px;
    background: var(--accent);
  }
  .stage__bar [data-state="err"] { color: oklch(56% 0.2 25); }

  .link {
    background: none; border: 0; padding: 0; cursor: pointer;
    font-family: var(--mono); font-size: var(--f-n2); color: var(--text-dim);
    text-decoration: underline; text-underline-offset: 3px;
  }
  .link:hover { color: var(--accent); }
  .link--end { margin-left: auto; }

  .src__tabs { display: flex; align-items: center; gap: 2px; border-bottom: var(--rule); }
  .src__tablist { display: flex; align-items: center; gap: 2px; }
  .src__tab {
    padding: var(--s-3xs) var(--s-2xs); background: none; border: 0;
    border-bottom: 2px solid transparent; margin-bottom: -1px; cursor: pointer;
    font-family: var(--mono); font-size: var(--f-n2); color: var(--text-dim);
  }
  .src__tab[aria-selected="true"] { color: var(--text); border-bottom-color: var(--accent); }
  .src__text {
    display: block; width: 100%; padding: var(--s-xs) 0; border: 0; resize: vertical;
    background: transparent; color: var(--text);
    font-family: var(--mono); font-size: var(--f-n1); line-height: 1.7; tab-size: 2;
  }
  .src__text:focus { outline: none; }
  .src__note { padding-top: var(--s-3xs); border-top: var(--rule); font-size: var(--f-n2); color: var(--text-dim); }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .say, .stage, .src {
        animation: doc-in linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 18%;
      }
      @keyframes doc-in { from { opacity: 0; transform: translateY(16px) } }
    }
  }

  .say { margin-top: var(--s-l); }
  .say h2 { margin-bottom: var(--s-2xs); }
  .say__p { margin-top: var(--s-2xs); color: var(--text-dim); }
  .say__p:first-of-type { font-family: var(--serif); font-size: var(--f-1); line-height: var(--lh-lead); color: var(--text); }

  .quote {
    margin: 0; padding-left: var(--s-s); border-left: 2px solid var(--accent);
    font-family: var(--mono); font-size: var(--f-n1); line-height: 1.75;
    white-space: pre-wrap; overflow-wrap: anywhere;
  }
  .quote--muted { border-left-color: var(--border); }

  .try { margin-top: var(--s-m); }
  .try__n { margin-bottom: var(--s-3xs); font-family: var(--mono); font-size: var(--f-n2); color: var(--text-dim); }
  .try__why { margin: var(--s-2xs) 0 0 var(--s-s); color: var(--text-dim); font-size: var(--f-n1); }

  .jump {
    display: flex; justify-content: space-between; gap: var(--s-m);
    margin-top: var(--s-2xl); padding-top: var(--s-s); border-top: var(--rule);
  }
  .jump a { display: grid; gap: 2px; text-decoration: none; font-size: var(--f-n1); }
  .jump a span { font-family: var(--mono); font-size: var(--f-n2); color: var(--text-dim); }
  .jump__next { text-align: right; }

  /* The fixed pager already carries these two links on a phone, and it carries
     them where a thumb is. */
  @media (max-width: 860px) { .jump { display: none; } }
</style>
