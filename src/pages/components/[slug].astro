---
import Base from '../../layouts/Base.astro';
import { allComponents } from '../../lib/registry.js';

export async function getStaticPaths() {
  const all = allComponents();
  return all.map((c, i) => ({
    params: { slug: c.slug },
    props: { c, prev: all[i - 1] ?? null, next: all[i + 1] ?? null }
  }));
}
const { c, prev, next } = Astro.props;
const repo = `https://github.com/Shinzuu/prism/blob/main/${c.repoPath}`;
const files = [
  { label: 'index.html', lang: 'html', body: c.html },
  { label: 'style.css', lang: 'css', body: c.css },
  ...(c.js ? [{ label: 'script.js', lang: 'js', body: c.js }] : [])
];
---
<Base title={c.name} description={c.summary}>
  <article class="doc" data-wb>
    <header class="doc__head">
      <h1>{c.name}</h1>
      <p class="doc__sum">{c.summary}</p>
      <p class="doc__meta"><span>{c.type}</span><span>week {c.week}</span><a href={repo}>source</a></p>
    </header>

    <figure class="stage">
      <div class="stage__wrap" data-wb-wrap>
        <iframe class="stage__frame" data-wb-frame title={`${c.name}, running`} sandbox="allow-scripts"></iframe>
      </div>
      <figcaption class="stage__bar">
        <span data-wb-status data-state="edit">loading</span>
        <span class="rig" data-wb-rig>
          <button type="button" data-w="360" aria-pressed="false">360</button>
          <button type="button" data-w="768" aria-pressed="false">768</button>
          <button type="button" data-w="full" aria-pressed="true">full</button>
        </span>
        <button class="link" type="button" data-wb-reset>restore original</button>
      </figcaption>
    </figure>

    <section class="src">
      <div class="src__tabs" role="tablist" aria-label="Files">
        {files.map((f, i) => (
          <button class="src__tab" type="button" role="tab" data-wb-tab={f.lang}
            aria-selected={i === 0 ? 'true' : 'false'}>{f.label}</button>
        ))}
        <button class="link link--end" type="button" data-wb-copy>copy</button>
      </div>
      {files.map((f, i) => (
        <textarea class="src__text" data-wb-pane={f.lang} hidden={i !== 0}
          spellcheck="false" aria-label={f.label} rows="20">{f.body}</textarea>
      ))}
      <p class="src__note">Editable. The frame re-renders as you type.</p>
    </section>

    <section class="say">
      <h2>The prompt</h2>
      <pre class="quote">{c.finalPrompt}</pre>
    </section>

    {c.attempts.length > 0 && (
      <section class="say">
        <h2>What came before it</h2>
        {c.attempts.map((a, i) => (
          <div class="try">
            <p class="try__n">Attempt {i + 1}</p>
            <pre class="quote quote--muted">{a.prompt}</pre>
            <p class="try__why">{a.problem}</p>
          </div>
        ))}
      </section>
    )}

    {c.why && (
      <section class="say">
        <h2>Why the last one worked</h2>
        {c.why.split('\n\n').map((p) => <p class="say__p">{p}</p>)}
      </section>
    )}

    <nav class="jump">
      {prev ? <a href={`/components/${prev.slug}`}><span>previous</span>{prev.name}</a> : <span></span>}
      {next ? <a class="jump__next" href={`/components/${next.slug}`}><span>next</span>{next.name}</a> : <span></span>}
    </nav>
  </article>
</Base>

<script is:inline src="/workbench.js"></script>

<style>
  /* Bleed. Prose keeps a 66ch measure; the specimen and its source break the
     column and run the full well, so looking and reading stay distinct. */
  .doc {
    display: grid;
    grid-template-columns:
      [wide-start] minmax(0, 1fr)
      [text-start] min(var(--measure), 100%) [text-end]
      minmax(0, 1fr) [wide-end];
    row-gap: var(--s-m);
  }
  .doc > * { grid-column: text; }

  .doc__head h1 { font-size: var(--f-4); }
  .doc__sum { margin-top: var(--s-2xs); font-size: var(--f-1); line-height: var(--lh-lead); color: var(--text-dim); }
  .doc__meta { display: flex; gap: var(--s-s); margin-top: var(--s-2xs); font-family: var(--mono); font-size: var(--f-n2); color: var(--text-dim); }
  .doc__meta a { color: var(--text-dim); }
  .doc__meta a:hover { color: var(--accent); }

  .stage, .src { grid-column: wide; }
  .stage { margin: var(--s-s) 0 0; border: var(--rule); border-radius: var(--radius); overflow: hidden; }
  .stage__wrap { margin: 0 auto; transition: max-width 220ms cubic-bezier(.2,.7,.3,1); }
  .stage__wrap[data-narrow="true"] { border-inline: var(--rule); }
  .stage__frame { display: block; width: 100%; height: clamp(240px, 34vh, 380px); border: 0; background: var(--bg); }

  .rig { display: inline-flex; gap: 2px; margin-left: var(--s-2xs); }
  .rig button {
    padding: 2px 7px; cursor: pointer; background: var(--bg);
    border: var(--rule); border-radius: var(--radius);
    font-family: var(--mono); font-size: var(--f-n2); color: var(--text-dim);
  }
  .rig button[aria-pressed="true"] { color: var(--accent-fg); background: var(--accent); border-color: var(--accent); }
  .stage__bar {
    display: flex; align-items: center; gap: var(--s-s);
    padding: var(--s-3xs) var(--s-xs); border-top: var(--rule); background: var(--surface);
    font-family: var(--mono); font-size: var(--f-n2); color: var(--text-dim);
  }
  .stage__bar [data-state="ok"] { color: var(--accent); }
  .stage__bar [data-state="err"] { color: oklch(56% 0.2 25); }

  .link {
    background: none; border: 0; padding: 0; cursor: pointer;
    font-family: var(--mono); font-size: var(--f-n2); color: var(--text-dim);
    text-decoration: underline; text-underline-offset: 3px;
  }
  .link:hover { color: var(--accent); }
  .link--end { margin-left: auto; }

  .src__tabs { display: flex; align-items: center; gap: 2px; border-bottom: var(--rule); }
  .src__tab {
    padding: var(--s-3xs) var(--s-2xs); background: none; border: 0;
    border-bottom: 2px solid transparent; margin-bottom: -1px; cursor: pointer;
    font-family: var(--mono); font-size: var(--f-n2); color: var(--text-dim);
  }
  .src__tab[aria-selected="true"] { color: var(--text); border-bottom-color: var(--accent); }
  .src__text {
    display: block; width: 100%; padding: var(--s-xs) 0; border: 0; resize: vertical;
    background: transparent; color: var(--text);
    font-family: var(--mono); font-size: var(--f-n1); line-height: 1.7; tab-size: 2;
  }
  .src__text:focus { outline: none; }
  .src__note { padding-top: var(--s-3xs); border-top: var(--rule); font-size: var(--f-n2); color: var(--text-dim); }

  .say { margin-top: var(--s-l); }
  .say h2 { margin-bottom: var(--s-2xs); }
  .say__p { margin-top: var(--s-2xs); color: var(--text-dim); }
  .say__p:first-of-type { font-family: var(--serif); font-size: var(--f-1); line-height: var(--lh-lead); color: var(--text); }

  .quote {
    margin: 0; padding-left: var(--s-s); border-left: 2px solid var(--accent);
    font-family: var(--mono); font-size: var(--f-n1); line-height: 1.75;
    white-space: pre-wrap; overflow-wrap: anywhere;
  }
  .quote--muted { border-left-color: var(--border); }

  .try { margin-top: var(--s-m); }
  .try__n { margin-bottom: var(--s-3xs); font-family: var(--mono); font-size: var(--f-n2); color: var(--text-dim); }
  .try__why { margin: var(--s-2xs) 0 0 var(--s-s); color: var(--text-dim); font-size: var(--f-n1); }

  .jump {
    display: flex; justify-content: space-between; gap: var(--s-m);
    margin-top: var(--s-2xl); padding-top: var(--s-s); border-top: var(--rule);
  }
  .jump a { display: grid; gap: 2px; text-decoration: none; font-size: var(--f-n1); }
  .jump a span { font-family: var(--mono); font-size: var(--f-n2); color: var(--text-dim); }
  .jump__next { text-align: right; }
</style>
