---
import Base from '../../layouts/Base.astro';
import { allComponents } from '../../lib/registry.js';

export async function getStaticPaths() {
  return allComponents().map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const repo = `https://github.com/Shinzuu/prism/blob/main/${c.repoPath}`;
const files = [
  { label: 'index.html', lang: 'html', body: c.html },
  { label: 'style.css', lang: 'css', body: c.css },
  ...(c.js ? [{ label: 'script.js', lang: 'js', body: c.js }] : [])
];
---
<Base title={c.name} description={c.summary}>
  <article class="specimen" data-wb>
    <header class="specimen__head">
      <h1>{c.name}</h1>
      <p class="specimen__sum">{c.summary}</p>
      <p class="specimen__meta">
        <span>{c.type}</span><span>week {c.week}</span><a href={repo}>source</a>
      </p>
    </header>

    <div class="stage">
      <iframe class="stage__frame" data-wb-frame title={`${c.name}, running`} sandbox="allow-scripts"></iframe>
      <div class="stage__foot">
        <span class="stage__state" data-wb-status data-state="edit">loading</span>
        <button class="txt" type="button" data-wb-reset>restore original</button>
      </div>
    </div>

    <section class="source">
      <div class="source__tabs" role="tablist" aria-label="Files">
        {files.map((f, i) => (
          <button class="source__tab" type="button" role="tab" data-wb-tab={f.lang}
            aria-selected={i === 0 ? 'true' : 'false'}>{f.label}</button>
        ))}
        <button class="txt txt--right" type="button" data-wb-copy>copy</button>
      </div>
      {files.map((f, i) => (
        <textarea class="source__text" data-wb-pane={f.lang} hidden={i !== 0}
          spellcheck="false" aria-label={f.label} rows="18">{f.body}</textarea>
      ))}
      <p class="source__note">Editable. The frame above re-renders as you type.</p>
    </section>

    <section class="prompt">
      <h2>The prompt</h2>
      <pre class="prompt__text">{c.finalPrompt}</pre>
    </section>

    {c.attempts.length > 0 && (
      <section class="prior">
        <h2>What came before it</h2>
        {c.attempts.map((a, i) => (
          <div class="prior__item">
            <p class="prior__n">Attempt {i + 1}</p>
            <pre class="prior__text">{a.prompt}</pre>
            <p class="prior__why">{a.problem}</p>
          </div>
        ))}
      </section>
    )}

    {c.why && (
      <section class="lesson">
        <h2>Why the last one worked</h2>
        {c.why.split('\n\n').map((p) => <p>{p}</p>)}
      </section>
    )}
  </article>
</Base>

<script is:inline src="/workbench.js"></script>

<style>
  .specimen { padding-top: 6px; }

  .specimen__head { max-width: var(--measure); margin-bottom: 26px; }
  .specimen__head h1 { margin: 0 0 8px; font-size: clamp(28px, 4vw, 40px); line-height: 1.1; }
  .specimen__sum { margin: 0 0 10px; color: var(--text-dim); max-width: 54ch; }
  .specimen__meta { display: flex; gap: 20px; margin: 0; font-family: var(--mono); font-size: 11.5px; color: var(--text-dim); }
  .specimen__meta a { color: var(--text-dim); }
  .specimen__meta a:hover { color: var(--accent); }

  .stage { border: var(--rule); border-radius: var(--radius); overflow: hidden; }
  .stage__frame { display: block; width: 100%; height: 280px; border: 0; background: var(--bg); }
  .stage__foot {
    display: flex; align-items: center; gap: 14px;
    padding: 7px 12px; border-top: var(--rule); background: var(--surface);
  }
  .stage__state { font-family: var(--mono); font-size: 11px; color: var(--text-dim); }
  .stage__state[data-state="ok"] { color: var(--accent); }
  .stage__state[data-state="err"] { color: oklch(56% 0.2 25); }

  .txt {
    background: none; border: 0; padding: 0; cursor: pointer;
    font-family: var(--mono); font-size: 11px; color: var(--text-dim);
    text-decoration: underline; text-underline-offset: 3px;
  }
  .txt:hover { color: var(--accent); }
  .txt--right { margin-left: auto; }

  .source { margin-top: 26px; }
  .source__tabs { display: flex; align-items: center; gap: 4px; border-bottom: var(--rule); }
  .source__tab {
    padding: 7px 11px; background: none; border: 0; border-bottom: 2px solid transparent;
    margin-bottom: -1px; cursor: pointer;
    font-family: var(--mono); font-size: 12px; color: var(--text-dim);
  }
  .source__tab[aria-selected="true"] { color: var(--text); border-bottom-color: var(--accent); }

  .source__text {
    display: block; width: 100%; padding: 16px 0 16px 2px;
    border: 0; resize: vertical; background: transparent; color: var(--text);
    font-family: var(--mono); font-size: 12.5px; line-height: 1.65; tab-size: 2;
  }
  .source__text:focus { outline: none; }
  .source__note { margin: 0; padding-top: 8px; border-top: var(--rule); font-size: 12px; color: var(--text-dim); }

  .prompt, .prior, .lesson { margin-top: 44px; }
  .prompt h2, .prior h2, .lesson h2 { margin: 0 0 12px; font-size: 20px; }

  .prompt__text, .prior__text {
    margin: 0; padding: 0 0 0 18px; border-left: 2px solid var(--accent);
    font-family: var(--mono); font-size: 12.5px; line-height: 1.7;
    white-space: pre-wrap; overflow-wrap: anywhere; max-width: 78ch;
  }
  .prior__text { border-left-color: var(--border); font-size: 12px; }

  .prior__item { margin-bottom: 26px; }
  .prior__n { margin: 0 0 7px; font-family: var(--mono); font-size: 11px; color: var(--text-dim); }
  .prior__why { margin: 10px 0 0 18px; color: var(--text-dim); font-size: 14px; max-width: 64ch; }

  .lesson p { color: var(--text-dim); max-width: var(--measure); margin: 0 0 12px; }
  .lesson p:first-of-type { font-family: var(--serif); font-size: 17px; color: var(--text); }
</style>
