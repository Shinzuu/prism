---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { allComponents } from '../lib/registry.js';
const cs = allComponents();
const TOTAL = 30;
---
<Base title="Index" scope={true}>
  <Hero count={cs.length} total={TOTAL} />

  <div class="tally">
    <span>{cs.length} of {TOTAL}</span>
    <span>two each week</span>
    <span>plain HTML, CSS, JavaScript</span>
    <span>no literal colour compiles</span>
  </div>

  <ol class="list">
    {cs.map((c, i) => (
      <li class="line">
        <span class="line__no">{String(i + 1).padStart(2, '0')}</span>
        <div class="line__say">
          <h2><a href={`/components/${c.slug}`}>{c.name}</a></h2>
          <p>{c.summary}</p>
          <span class="line__meta">{c.type}, week {c.week}</span>
        </div>
        <a class="line__see" href={`/components/${c.slug}`} tabindex="-1" aria-hidden="true">
          <iframe src={`/preview/${c.slug}`} loading="lazy" sandbox="allow-scripts"
            title={c.name} tabindex="-1"></iframe>
        </a>
      </li>
    ))}
  </ol>
</Base>

<style>
  /* Ledger. 1120px well on a 1440 screen, 5:7 split so the specimen leads
     while the text column holds 46 characters. */
  .tally {
    margin-top: var(--s-l);
    display: flex; flex-wrap: wrap; gap: var(--s-3xs) var(--s-m);
    padding: var(--s-2xs) 0; border-top: var(--rule); border-bottom: var(--rule);
    font-family: var(--mono); font-size: var(--f-n2); color: var(--text-dim);
    letter-spacing: var(--tr-mono);
  }

  .list { list-style: none; margin: 0; padding: 0; }
  .line {
    display: grid; grid-template-columns: 2.4em 5fr 7fr; gap: var(--s-s) var(--s-m);
    padding: var(--s-m) 0; border-bottom: var(--rule); align-items: start;
  }
  .line__no { font-family: var(--mono); font-size: var(--f-n2); color: var(--text-dim); padding-top: 0.6em; }
  .line__say h2 a { text-decoration: none; }
  .line__say h2 a:hover { color: var(--accent); }
  .line__say p { margin-top: var(--s-3xs); color: var(--text-dim); font-size: var(--f-n1); max-width: 46ch; }
  .line__meta { display: block; margin-top: var(--s-2xs); font-family: var(--mono); font-size: var(--f-n2); color: var(--text-dim); }

  .line__see { display: block; border: var(--rule); border-radius: var(--radius); overflow: hidden; background: var(--surface); }
  .line__see:hover { border-color: var(--accent); }
  .line__see iframe { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; }

  @media (max-width: 760px) {
    .line { grid-template-columns: 2.4em 1fr; }
    .line__see { grid-column: 1 / -1; }
    .line__see iframe { aspect-ratio: 4 / 3; }
  }
</style>
