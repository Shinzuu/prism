---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { allComponents, plannedComponents, COMPONENT_TYPES } from '../lib/registry.js';

const built = allComponents();
const planned = plannedComponents();
const all = [...built, ...planned].sort((a, b) => a.week - b.week || a.name.localeCompare(b.name));
const counts = COMPONENT_TYPES.map((t) => ({
  type: t,
  total: all.filter((c) => c.type === t).length,
  done: built.filter((c) => c.type === t).length
}));
---
<Base title="Library">
  <Hero count={built.length} total={all.length} />

  <section class="filters" aria-label="Filter the library">
    <div class="filters__search">
      <input id="q" type="search" placeholder="Search by name, type or behaviour" autocomplete="off"
        aria-label="Search components" />
      <span class="filters__count" id="count" aria-live="polite"></span>
    </div>
    <div class="chips" role="group" aria-label="Filter by type">
      <button class="chipf is-on" type="button" data-type="all">all <i>{all.length}</i></button>
      {counts.map((c) => (
        <button class="chipf" type="button" data-type={c.type}>{c.type} <i>{c.done}/{c.total}</i></button>
      ))}
    </div>
  </section>

  <ol class="grid" id="grid">
    {all.map((c) => (
      <li class={`cell ${c.planned ? 'cell--soon' : ''}`}
        data-type={c.type} data-week={c.week}
        data-search={`${c.name} ${c.type} ${c.summary}`.toLowerCase()}>
        {c.planned ? (
          <div class="cell__inner">
            <div class="cell__head">
              <span class="tag">{c.type}</span>
              <span class="cell__wk">week {c.week}</span>
            </div>
            <h2>{c.name}</h2>
            <p>{c.summary}</p>
            <span class="cell__soon">scheduled</span>
          </div>
        ) : (
          <a class="cell__inner" href={`/components/${c.slug}`}>
            <div class="cell__view">
              <iframe src={`/preview/${c.slug}`} loading="lazy" sandbox="allow-scripts"
                title={c.name} tabindex="-1"></iframe>
            </div>
            <div class="cell__head">
              <span class="tag">{c.type}</span>
              <span class="cell__wk">week {c.week}</span>
            </div>
            <h2>{c.name}</h2>
            <p>{c.summary}</p>
          </a>
        )}
      </li>
    ))}
  </ol>

  <p class="empty" id="empty" hidden>Nothing matches that.</p>
</Base>

<script is:inline>
  (() => {
    const grid = document.getElementById('grid');
    const cells = [...grid.querySelectorAll('.cell')];
    const q = document.getElementById('q');
    const count = document.getElementById('count');
    const empty = document.getElementById('empty');
    const chips = [...document.querySelectorAll('.chipf')];
    let type = 'all';

    function apply() {
      const term = q.value.trim().toLowerCase();
      const match = (cell) =>
        (type === 'all' || cell.dataset.type === type) &&
        (!term || cell.dataset.search.includes(term));

      // window.prismFilter is installed by the motion layer and animates the
      // reflow with Flip. Until it loads, fall back to a plain toggle.
      if (window.prismFilter) window.prismFilter(match);
      else cells.forEach((c) => { c.hidden = !match(c); });

      const shown = cells.filter((c) => !c.hidden).length;
      count.textContent = `${shown} shown`;
      empty.hidden = shown > 0;
    }

    q.addEventListener('input', apply);
    chips.forEach((c) => c.addEventListener('click', () => {
      chips.forEach((x) => x.classList.toggle('is-on', x === c));
      type = c.dataset.type;
      apply();
    }));
    addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== q) { e.preventDefault(); q.focus(); }
    });
    apply();
  })();
</script>

<style>
  .filters { margin: var(--s-l) 0 var(--s-m); display: grid; gap: var(--s-xs); }
  .filters__search { display: flex; align-items: center; gap: var(--s-s); }
  #q {
    flex: 1; min-width: 0; padding: 13px 18px;
    background: color-mix(in oklab, var(--surface) 70%, transparent);
    border: var(--rule); border-radius: 999px;
    color: var(--text); font: inherit; font-size: var(--f-n1);
  }
  #q::placeholder { color: var(--text-dim); }
  #q:focus { outline: none; border-color: var(--accent); background: var(--surface); }
  .filters__count { font-family: var(--mono); font-size: var(--f-n2); color: var(--text-dim); white-space: nowrap; }

  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chipf {
    padding: 7px 14px; cursor: pointer;
    background: transparent; color: var(--text-dim);
    border: var(--rule); border-radius: 999px;
    font-size: var(--f-n2); font-weight: 500;
    transition: color 160ms ease, background 160ms ease, border-color 160ms ease;
  }
  .chipf i {
    font-style: normal; margin-left: 6px; opacity: .6;
    font-variant-numeric: tabular-nums;
  }
  .chipf:hover { color: var(--text); }
  .chipf.is-on { color: var(--accent-fg); background: var(--accent); border-color: var(--accent); }

  .grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-s); align-items: start;
  }
  .cell__inner {
    display: grid; gap: 8px; height: 100%; padding: var(--s-s);
    background: color-mix(in oklab, var(--surface) 55%, transparent);
    border: var(--rule); border-radius: var(--radius);
    color: inherit; text-decoration: none;
    transition: background 200ms ease, border-color 200ms ease;
  }
  a.cell__inner:hover { background: var(--surface); border-color: color-mix(in oklab, var(--accent) 45%, transparent); }

  .cell__view { border: var(--rule); border-radius: var(--radius-sm); overflow: hidden; background: var(--bg); }
  .cell__view iframe { display: block; width: 100%; aspect-ratio: 16 / 7; border: 0; }

  .cell__head { display: flex; align-items: center; gap: var(--s-2xs); }
  .tag {
    padding: 3px 10px; border-radius: 999px;
    background: color-mix(in oklab, var(--accent) 15%, transparent); color: var(--accent);
    font-size: var(--f-n2); font-weight: 500;
  }
  .cell__wk { margin-left: auto; font-size: var(--f-n2); color: var(--text-dim); font-variant-numeric: tabular-nums; }
  .cell h2 { font-size: var(--f-1); }
  .cell p { color: var(--text-dim); font-size: var(--f-n1); }

  /* Scheduled entries are denser and quieter: the grid reads as progress
     rather than as one repeated card. */
  .cell--soon .cell__inner { background: transparent; padding: var(--s-2xs) var(--s-s); gap: 4px; }
  .cell--soon h2 { font-size: var(--f-0); }
  .cell--soon p { font-size: var(--f-n2); }
  .cell--soon h2 { color: var(--text-dim); }
  .cell__soon {
    justify-self: start; margin-top: auto; padding-top: 4px;
    font-family: var(--mono); font-size: var(--f-n2); color: var(--text-dim);
  }

  .empty { margin-top: var(--s-l); text-align: center; color: var(--text-dim); }

  @media (max-width: 720px) { .grid { grid-template-columns: 1fr; } }
</style>
