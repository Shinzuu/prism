---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { allComponents, plannedComponents, COMPONENT_TYPES } from '../lib/registry.js';

const built = allComponents();
const planned = plannedComponents();
const all = [...built, ...planned];

const LABEL = {
  button: 'Buttons', card: 'Cards', chart: 'Charts', form: 'Forms', input: 'Inputs',
  loader: 'Loaders', modal: 'Modals', navbar: 'Navigation', section: 'Sections', table: 'Tables'
};
const BLURB = {
  button: 'Actions, and the deliberation some of them need.',
  card: 'Surfaces that hold one thing and respond to attention.',
  chart: 'Quantities, shapes and distributions, with the table behind them.',
  form: 'Input that parses what people actually type.',
  input: 'Single controls, and the edge cases they live or die on.',
  loader: 'Waiting, described honestly.',
  modal: 'Layers that take over, and give focus back.',
  navbar: 'Moving between places without losing your position.',
  section: 'Page-scale compositions driven by scroll or pointer.',
  table: 'Dense data, keyboard-first.'
};

const sections = COMPONENT_TYPES
  .map((type) => ({
    type,
    label: LABEL[type],
    blurb: BLURB[type],
    items: all.filter((c) => c.type === type).sort((a, b) => a.week - b.week || a.name.localeCompare(b.name)),
    done: built.filter((c) => c.type === type).length
  }))
  .filter((s) => s.items.length);
---
<Base title="Library" wide={true}>
  <Hero count={built.length} total={all.length} />

  <div class="lib">
    <aside class="rail">
      <div class="rail__inner">
        <div class="find">
          <input id="q" type="search" placeholder="Search" autocomplete="off" aria-label="Search components" />
          <span class="find__n" id="count" aria-live="polite"></span>
        </div>
        <nav class="rail__nav" aria-label="Component types">
          {sections.map((s) => (
            <a href={`#${s.type}`} data-jump={s.type}>
              <span>{s.label}</span>
              <i>{s.done}/{s.items.length}</i>
            </a>
          ))}
        </nav>
        <p class="rail__tot"><b>{built.length}</b> of {all.length} built</p>
      </div>
    </aside>

    <div class="stacks" id="stacks">
      {sections.map((s) => (
        <section class="stack" id={s.type} data-stack={s.type}>
          <header class="stack__head">
            <h2>{s.label}</h2>
            <p>{s.blurb}</p>
            <span class="stack__n">{s.done} of {s.items.length}</span>
          </header>

          <ol class="tiles">
            {s.items.map((c) => (
              <li class={`tile ${c.planned ? 'tile--soon' : ''}`}
                data-type={c.type}
                data-search={`${c.name} ${c.type} ${c.summary}`.toLowerCase()}>
                {c.planned ? (
                  <div class="tile__in">
                    <h3>{c.name}</h3>
                    <p>{c.summary}</p>
                    <span class="tile__wk">week {c.week} · scheduled</span>
                  </div>
                ) : (
                  <a class="tile__in" href={`/components/${c.slug}`}>
                    <span class="tile__view">
                      <iframe data-src={`/preview/${c.slug}`} loading="lazy" sandbox="allow-scripts"
                        title={c.name} tabindex="-1"></iframe>
                    </span>
                    <h3>{c.name}</h3>
                    <p>{c.summary}</p>
                    <span class="tile__wk">week {c.week}</span>
                  </a>
                )}
              </li>
            ))}
          </ol>
        </section>
      ))}
      <p class="empty" id="empty" hidden>Nothing matches that.</p>
    </div>
  </div>
</Base>

<script is:inline>
  (() => {
    const q = document.getElementById('q');
    const count = document.getElementById('count');
    const empty = document.getElementById('empty');
    const tiles = [...document.querySelectorAll('.tile')];
    const stacks = [...document.querySelectorAll('.stack')];
    const jumps = [...document.querySelectorAll('[data-jump]')];

    /* Attach a preview only when its tile is close. loading="lazy" fetches far
       ahead, and this page is built to hold hundreds of these. */
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const f = e.target.querySelector('iframe[data-src]');
        if (f) { f.src = f.dataset.src; f.removeAttribute('data-src'); }
        io.unobserve(e.target);
      }
    }, { rootMargin: '500px 0px' });
    document.querySelectorAll('.tile__view').forEach((v) => io.observe(v));

    function apply() {
      const term = q.value.trim().toLowerCase();
      let shown = 0;
      for (const t of tiles) {
        const on = !term || t.dataset.search.includes(term);
        t.hidden = !on;
        if (on) shown++;
      }
      // A section with nothing left in it disappears with its heading.
      for (const s of stacks) {
        s.hidden = ![...s.querySelectorAll('.tile')].some((t) => !t.hidden);
      }
      count.textContent = term ? `${shown} of ${tiles.length}` : `${tiles.length}`;
      empty.hidden = shown > 0;
    }

    q.addEventListener('input', apply);
    addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== q) { e.preventDefault(); q.focus(); }
      if (e.key === 'Escape' && document.activeElement === q) { q.value = ''; apply(); q.blur(); }
    });

    /* Mark the section being read, from a reading line rather than visibility. */
    function track() {
      const line = innerHeight * 0.3;
      let active = null;
      for (const s of stacks) {
        if (s.hidden) continue;
        if (s.getBoundingClientRect().top <= line) active = s.id;
      }
      if (!active && stacks.length) active = stacks.find((s) => !s.hidden)?.id;
      for (const j of jumps) j.setAttribute('aria-current', String(j.dataset.jump === active));
    }
    addEventListener('scroll', () => requestAnimationFrame(track), { passive: true });
    addEventListener('resize', track);

    apply();
    track();
  })();
</script>

<style>
  .lib { display: grid; grid-template-columns: 210px minmax(0, 1fr); gap: var(--s-xl); align-items: start; }

  .rail__inner { position: sticky; top: calc(var(--s-l) + var(--s-m)); display: grid; gap: var(--s-s); }

  .find { position: relative; display: flex; align-items: center; }
  #q {
    width: 100%; padding: 9px 44px 9px 13px;
    background: var(--surface); color: var(--text);
    border: var(--rule); border-radius: 999px;
    font: inherit; font-size: var(--f-n1);
  }
  #q:focus { outline: none; border-color: var(--accent); }
  .find__n {
    position: absolute; right: 13px; pointer-events: none;
    font-family: var(--mono); font-size: var(--f-n2); color: var(--text-dim);
    font-variant-numeric: tabular-nums;
  }

  .rail__nav { display: grid; }
  .rail__nav a {
    display: flex; align-items: baseline; gap: var(--s-2xs);
    padding: 6px 0; border-bottom: var(--rule);
    font-size: var(--f-n1); color: var(--text-dim); text-decoration: none;
  }
  .rail__nav a span { flex: 1; }
  .rail__nav a i { font-style: normal; font-size: var(--f-n2); font-variant-numeric: tabular-nums; opacity: .7; }
  .rail__nav a:hover { color: var(--text); }
  .rail__nav a[aria-current="true"] { color: var(--accent); }
  .rail__tot { font-size: var(--f-n2); color: var(--text-dim); font-variant-numeric: tabular-nums; }
  .rail__tot b { color: var(--text); }

  .stacks { display: grid; gap: var(--s-xl); }
  .stack { scroll-margin-top: calc(var(--s-2xl) + var(--s-s)); }

  /* Explicit placement: auto-placement put the count in column one and pushed
     the heading to the right. */
  .stack__head {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: "title count" "blurb count";
    align-items: baseline; column-gap: var(--s-s);
    padding-bottom: var(--s-2xs); margin-bottom: var(--s-m);
    border-bottom: 1px solid var(--text);
  }
  .stack__head h2 { grid-area: title; font-size: var(--f-2); }
  .stack__head p { grid-area: blurb; font-size: var(--f-n1); color: var(--text-dim); max-width: 52ch; }
  .stack__n {
    grid-area: count; align-self: start; padding-top: .35em;
    font-family: var(--mono); font-size: var(--f-n2);
    color: var(--text-dim); font-variant-numeric: tabular-nums;
  }

  .tiles {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(258px, 1fr)); gap: var(--s-s);
  }
  .tile__in {
    display: grid; gap: 6px; height: 100%;
    color: inherit; text-decoration: none;
  }
  /* A real border, not an inset shadow: the iframe paints over the padding box,
     so an inset shadow only survives at the rounded corners. */
  .tile__view {
    display: block; overflow: hidden; margin-bottom: 2px;
    border: 1px solid var(--border); border-radius: var(--radius-sm);
    background: var(--bg);
  }
  .tile__view iframe { display: block; width: 100%; aspect-ratio: 5 / 3; border: 0; }
  a.tile__in:hover .tile__view { border-color: var(--accent); }
  .tile h3 { font-size: var(--f-0); }
  a.tile__in:hover h3 { color: var(--accent); }
  .tile p { font-size: var(--f-n2); color: var(--text-dim); line-height: 1.5; }
  .tile__wk { font-size: var(--f-n2); color: var(--text-dim); font-variant-numeric: tabular-nums; }

  .tile--soon .tile__in {
    padding: var(--s-2xs) var(--s-xs);
    border: 1px dashed color-mix(in oklab, var(--border) 80%, transparent);
    border-radius: var(--radius-sm);
    align-content: start;
  }
  .tile--soon h3 { color: var(--text-dim); }

  .empty { margin-top: var(--s-l); text-align: center; color: var(--text-dim); }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .tile { animation: tile-in linear both; animation-timeline: view(); animation-range: entry 0% cover 18%; }
      @keyframes tile-in { from { opacity: 0; transform: translateY(14px) } }
    }
  }

  @media (max-width: 860px) {
    .lib { grid-template-columns: 1fr; gap: var(--s-m); }
    .rail__inner { position: static; }
    .rail__nav { grid-auto-flow: column; grid-auto-columns: max-content; overflow-x: auto; gap: var(--s-2xs); }
    .rail__nav a { border-bottom: 0; white-space: nowrap; padding: 5px 11px; border: var(--rule); border-radius: 999px; }
    .rail__tot { display: none; }
  }
</style>
