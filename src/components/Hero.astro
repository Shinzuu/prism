---
const { count, total } = Astro.props;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__grid" aria-hidden="true"></div>

  <svg class="hero__plate" viewBox="0 0 900 460" role="img" aria-label="Orthographic plan view of a fighter airframe with callouts">
    <g class="plate__rules" aria-hidden="true">
      <line x1="450" y1="10" x2="450" y2="450" />
      <line x1="40" y1="230" x2="860" y2="230" />
      <circle cx="450" cy="230" r="196" />
      <circle cx="450" cy="230" r="118" />
      <path d="M254 230 a196 196 0 0 1 392 0" />
    </g>

    <g class="plate__craft">
      <!-- fuselage -->
      <path class="ln ln--hull" d="M450 26
        C458 52 463 84 466 118
        L470 168 L473 206 L474 236
        L476 282 L474 318
        L479 344 L482 372 L478 392 L466 404
        L455 410 L450 434 L445 410 L434 404
        L422 392 L418 372 L421 344 L426 318
        L424 282 L426 236 L427 206 L430 168
        L434 118 C437 84 442 52 450 26 Z" />

      <!-- main delta wing, port and starboard -->
      <path class="ln ln--wing" d="M474 214 L658 258 L712 282 L718 300 L690 302 L474 292 Z" />
      <path class="ln ln--wing" d="M426 214 L242 258 L188 282 L182 300 L210 302 L426 292 Z" />

      <!-- leading-edge root extensions -->
      <path class="ln ln--lerx" d="M466 150 L500 196 L474 208 Z" />
      <path class="ln ln--lerx" d="M434 150 L400 196 L426 208 Z" />

      <!-- canards -->
      <path class="ln ln--canard" d="M463 116 L534 138 L556 150 L534 154 L464 140 Z" />
      <path class="ln ln--canard" d="M437 116 L366 138 L344 150 L366 154 L436 140 Z" />

      <!-- twin canted tailfins -->
      <path class="ln ln--fin" d="M470 300 L520 246 L534 250 L500 310 Z" />
      <path class="ln ln--fin" d="M430 300 L380 246 L366 250 L400 310 Z" />

      <!-- horizontal stabilators -->
      <path class="ln ln--stab" d="M476 330 L556 352 L570 364 L544 366 L476 350 Z" />
      <path class="ln ln--stab" d="M424 330 L344 352 L330 364 L356 366 L424 350 Z" />

      <!-- intakes -->
      <path class="ln ln--intake" d="M479 206 L497 214 L497 268 L479 262 Z" />
      <path class="ln ln--intake" d="M421 206 L403 214 L403 268 L421 262 Z" />

      <!-- exhaust nozzles -->
      <path class="ln ln--nozzle" d="M438 380 L440 404 L448 408 L448 380 Z" />
      <path class="ln ln--nozzle" d="M462 380 L460 404 L452 408 L452 380 Z" />

      <!-- canopy and spine -->
      <path class="ln ln--canopy" d="M450 52 C462 62 466 86 465 112 L450 118 L435 112 C434 86 438 62 450 52 Z" />
      <path class="ln ln--detail" d="M450 118 L450 214 M450 292 L450 380" />
      <path class="ln ln--detail" d="M474 236 L640 268 M426 236 L260 268" />
      <path class="ln ln--detail" d="M466 168 L474 214 M434 168 L426 214" />
      <circle class="ln ln--detail" cx="450" cy="88" r="5" />
    </g>

    <g class="plate__marks" aria-hidden="true">
      <path d="M22 22 h20 M22 22 v20 M878 22 h-20 M878 22 v20
               M22 438 h20 M22 438 v-20 M878 438 h-20 M878 438 v-20" />
    </g>
  </svg>

  <div class="hero__say">
    <p class="hero__plateno">plate 01 — airframe</p>
    <h1 id="hero-title">Components built<br />to a tolerance.</h1>
    <p class="hero__lead">
      Thirty pieces over ninety days. Each one plain HTML, CSS and JavaScript, each one
      recorded with the prompt that produced it, and none of them containing a colour
      value a machine did not derive.
    </p>
    <dl class="hero__spec">
      <div><dt>airframes</dt><dd>{count} / {total}</dd></div>
      <div><dt>payload</dt><dd>0 dependencies</dd></div>
      <div><dt>tolerance</dt><dd>build fails on literal colour</dd></div>
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative; isolation: isolate;
    display: grid; grid-template-columns: 1.05fr 1fr; gap: var(--s-l);
    align-items: center; min-height: 66vh;
    padding: var(--s-l) 0 var(--s-2xl);
  }

  .hero__grid {
    position: absolute; inset: 0; z-index: -1; opacity: .5;
    background:
      repeating-linear-gradient(to right, var(--border) 0 1px, transparent 1px 64px),
      repeating-linear-gradient(to bottom, var(--border) 0 1px, transparent 1px 64px);
    mask-image: radial-gradient(90% 70% at 32% 46%, #000 12%, transparent 72%);
  }

  .hero__plate { width: 100%; height: auto; overflow: visible; }

  .plate__rules line, .plate__rules circle, .plate__rules path {
    stroke: var(--border); stroke-width: 1; fill: none;
  }
  .plate__rules circle { stroke-dasharray: 3 8; }
  .plate__rules path { stroke: color-mix(in oklab, var(--accent) 45%, transparent); stroke-dasharray: 1 6; }

  .ln { fill: none; stroke: var(--text); stroke-width: 1.35; stroke-linejoin: round; stroke-linecap: round; }
  .ln--hull   { fill: color-mix(in oklab, var(--surface) 88%, transparent); stroke-width: 1.7; }
  .ln--wing   { fill: color-mix(in oklab, var(--surface) 62%, transparent); }
  .ln--lerx,
  .ln--canard,
  .ln--stab   { fill: color-mix(in oklab, var(--surface) 50%, transparent); }
  .ln--fin    { fill: color-mix(in oklab, var(--accent) 16%, transparent); stroke: color-mix(in oklab, var(--accent) 70%, var(--text)); }
  .ln--intake { fill: color-mix(in oklab, var(--bg) 82%, transparent); }
  .ln--nozzle { fill: var(--accent); stroke: var(--accent); }
  .ln--canopy { fill: color-mix(in oklab, var(--accent) 24%, transparent); stroke: color-mix(in oklab, var(--accent) 80%, var(--text)); }
  .ln--detail { stroke: color-mix(in oklab, var(--text) 45%, transparent); stroke-width: 0.9; }



  .plate__marks path { stroke: var(--accent); stroke-width: 1.4; fill: none; }

  .hero__plateno {
    display: inline-block; font-family: var(--mono); font-size: var(--f-n2); color: var(--accent);
    padding: 4px 11px; border-radius: 999px;
    background: color-mix(in oklab, var(--accent) 14%, transparent);
  }
  .hero__say h1 { margin-top: var(--s-s); font-size: var(--f-6); line-height: var(--lh-display); letter-spacing: var(--tr-display); }
  .hero__lead { margin-top: var(--s-s); font-size: var(--f-1); line-height: var(--lh-lead); color: var(--text-dim); max-width: 42ch; }

  .hero__spec { display: flex; flex-wrap: wrap; gap: var(--s-2xs); margin-top: var(--s-m); }
  .hero__spec > div {
    padding: var(--s-2xs) var(--s-s); border-radius: var(--radius-sm);
    background: color-mix(in oklab, var(--surface) 70%, transparent);
    border: var(--rule);
  }
  .hero__spec dt { font-family: var(--mono); font-size: var(--f-n2); color: var(--text-dim); }
  .hero__spec dd { margin: 2px 0 0; font-size: var(--f-n1); }

  /* One orchestrated load sequence: rules settle, the airframe draws itself,
     leaders extend, tags fade up. Nothing loops, nothing repeats on scroll. */
  @media (prefers-reduced-motion: no-preference) {
    .plate__rules line, .plate__rules circle { opacity: 0; animation: fade .6s ease forwards .1s; }
    .ln { stroke-dasharray: 1400; stroke-dashoffset: 1400; fill-opacity: 0;
          animation: draw 1.5s cubic-bezier(.6,0,.3,1) forwards, fill .7s ease forwards; }
    .ln--hull   { animation-delay: .30s, 1.45s }
    .ln--wing   { animation-delay: .55s, 1.60s }
    .ln--lerx   { animation-delay: .70s, 1.68s }
    .ln--canard { animation-delay: .80s, 1.74s }
    .ln--fin    { animation-delay: .90s, 1.80s }
    .ln--stab   { animation-delay: .98s, 1.86s }
    .ln--intake { animation-delay: 1.06s, 1.92s }
    .ln--nozzle { animation-delay: 1.14s, 1.98s }
    .ln--canopy { animation-delay: 1.22s, 2.04s }
    .ln--detail { animation-delay: 1.34s, 2.10s; stroke-dasharray: 400; stroke-dashoffset: 400; }
    .plate__marks path { opacity: 0; animation: fade .5s ease forwards 2.3s; }
    .hero__say > * { opacity: 0; animation: rise .6s cubic-bezier(.2,.7,.3,1) forwards; }
    .hero__say > :nth-child(1) { animation-delay: .25s }
    .hero__say > :nth-child(2) { animation-delay: .35s }
    .hero__say > :nth-child(3) { animation-delay: .5s }
    .hero__say > :nth-child(4) { animation-delay: .65s }
  }

  @keyframes draw { to { stroke-dashoffset: 0 } }
  @keyframes fade { to { opacity: 1 } }
  @keyframes fill { to { fill-opacity: 1 } }
  @keyframes rise { from { opacity: 0; translate: 0 10px } to { opacity: 1; translate: 0 0 } }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; min-height: 0; gap: var(--s-m); }
    .hero__plate { max-width: 460px; margin: 0 auto; }
  }
</style>
