---
import Airframe from './hero/Airframe.tsx';
const { count, total } = Astro.props;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__field" aria-hidden="true"></div>

  <div class="hero__say">
    <h1 id="hero-title">
      <span class="ln1"><i>Components</i></span>
      <span class="ln2"><i>built to a</i></span>
      <span class="ln3"><i>tolerance.</i></span>
    </h1>
    <p class="hero__lead">
      Thirty pieces in ninety days, and it kept going. React, TypeScript and Tailwind,
      every one recorded with the prompt that produced it, and not a single colour a
      machine did not derive.
    </p>
    <p class="hero__meta"><b>{count}</b> of {total} built · addressable by element id · a literal colour fails the build</p>
  </div>

  <figure class="hero__plate">
    {/* The 3D sheet draws itself over the SVG and hides it once it is running.
        The SVG stays in the document as the no-JS and no-WebGL drawing — it is
        the same aircraft, to the same dimensions, so nothing is lost. */}
    <Airframe client:visible />

    <svg viewBox="0 0 760 620" role="img" aria-label="Three-view general arrangement drawing of a variable-geometry fighter: side elevation, plan view and front elevation, with dimensions and a title block">
      <g class="rules" aria-hidden="true">
        <line x1="60" y1="330" x2="700" y2="330" />
        <line x1="150" y1="500" x2="150" y2="596" />
      </g>

      <g class="craft">
        <!-- ─── SIDE ELEVATION ─────────────────────────────────────────── -->
        <g class="view view--side">
          <path class="ln hull" d="M70 150
            C104 138 142 130 196 124 L238 118
            C258 106 292 100 326 102 L382 110 L470 116 L566 122 L640 128 L688 134
            L688 148 L640 154 L560 159 L470 163 L360 165 L258 161
            C196 157 126 154 70 150 Z" />
          <path class="ln radome" d="M70 150 C92 145 112 141 132 138 L136 152 L108 154 Z" />
          <path class="ln canopy" d="M244 116 C262 102 292 96 322 98 L360 104 L362 112 L246 118 Z" />
          <path class="ln fin" d="M498 116 L568 50 L598 50 L586 116 Z" />
          <path class="ln fin" d="M472 116 L540 58 L560 58 L552 116 Z" />
          <path class="ln stab" d="M602 134 L692 124 L716 132 L690 142 L604 148 Z" />
          <path class="ln nacelle" d="M276 160 L474 162 L474 184 L286 182 Z" />
          <path class="ln nozzle" d="M672 130 L714 128 L718 142 L714 154 L672 152 Z" />
          <path class="ln pylon" d="M330 182 L346 182 L344 196 L332 196 Z" />
          <path class="ln pylon" d="M406 182 L422 182 L420 196 L408 196 Z" />
          <path class="ln detail" d="M196 124 L196 158 M382 110 L382 162 M470 116 L470 163" />
          <path class="ln detail" d="M136 144 L470 130" />
          <text class="cap" x="70" y="216">SIDE ELEVATION</text>
        </g>

        <!-- ─── PLAN VIEW ──────────────────────────────────────────────── -->
        <g class="view view--plan">
          <!-- Painted back to front: the surfaces that pass under the airframe
               are drawn first, so the fuselage occludes them the way it does in
               a real plan view rather than sitting under a stack of sheets. -->
          <path class="ln stab" d="M600 316 L700 284 L720 290 L702 304 L612 326 Z" />
          <path class="ln stab" d="M600 364 L700 396 L720 390 L702 376 L612 354 Z" />

          <g class="wing wing--stbd">
            <path class="ln" d="M396 296 L616 248 L650 254 L626 268 L432 312 Z" />
            <path class="ln slat" d="M408 298 L612 254" />
          </g>
          <g class="wing wing--port">
            <path class="ln" d="M396 384 L616 432 L650 426 L626 412 L432 368 Z" />
            <path class="ln slat" d="M408 382 L612 426" />
          </g>

          <path class="ln glove" d="M286 318 L400 294 L436 300 L340 320 Z" />
          <path class="ln glove" d="M286 362 L400 386 L436 380 L340 360 Z" />

          <path class="ln nacelle" d="M320 314 L570 313 L600 320 L600 330 L320 330 Z" />
          <path class="ln nacelle" d="M320 366 L570 367 L600 360 L600 350 L320 350 Z" />

          <path class="ln hull" d="M70 340
            C104 334 142 329 196 325 L246 320 L330 314 L470 310 L600 314 L660 320
            L660 360 L600 366 L470 370 L330 366 L246 360 L196 355
            C142 351 104 346 70 340 Z" />
          <path class="ln radome" d="M70 340 C92 337 112 334 132 332 L134 348 L108 350 Z" />
          <path class="ln canopy" d="M250 324 C270 318 296 315 318 316 L348 318 L348 362 L318 364 C296 365 270 362 250 356 Z" />

          <path class="ln fin" d="M516 312 L568 276 L582 278 L554 314 Z" />
          <path class="ln fin" d="M516 368 L568 404 L582 402 L554 366 Z" />
          <path class="ln nozzle" d="M602 322 L650 320 L654 332 L604 332 Z" />
          <path class="ln nozzle" d="M602 358 L650 360 L654 348 L604 348 Z" />
          <path class="ln pylon" d="M432 304 L444 301 L448 314 L436 317 Z" />
          <path class="ln pylon" d="M432 376 L444 379 L448 366 L436 363 Z" />
          <path class="ln detail" d="M196 325 L196 355 M330 314 L330 366 M470 310 L470 370" />
          <text class="cap" x="86" y="452">PLAN VIEW</text>
        </g>

        <!-- ─── FRONT ELEVATION ────────────────────────────────────────── -->
        <g class="view view--front">
          <path class="ln hull" d="M128 548 C128 530 138 520 152 520 C166 520 176 530 176 548
            L174 572 L130 572 Z" />
          <path class="ln canopy" d="M138 522 C142 511 162 511 166 522 Z" />
          <path class="ln wingf" d="M176 544 L268 538 L282 550 L266 560 L176 558 Z" />
          <path class="ln wingf" d="M128 544 L36 538 L22 550 L38 560 L128 558 Z" />
          <path class="ln nacelle" d="M110 542 L128 542 L130 574 L112 574 Z" />
          <path class="ln nacelle" d="M194 542 L176 542 L174 574 L192 574 Z" />
          <path class="ln fin" d="M164 520 L178 486 L188 486 L176 520 Z" />
          <path class="ln fin" d="M140 520 L126 486 L116 486 L128 520 Z" />
          <text class="cap" x="22" y="600">FRONT ELEVATION</text>
        </g>

        <!-- ─── DIMENSIONS ─────────────────────────────────────────────── -->
        <g class="dims" aria-hidden="true">
          <path class="ln dim" d="M70 440 L70 478 M718 440 L718 478
                                   M74 470 L714 470
                                   M74 470 l9 -4 v8 z M714 470 l-9 -4 v8 z" />
          <text class="dim__t" x="394" y="464">19.10 m</text>
          <path class="ln dim" d="M726 246 L744 246 M726 434 L744 434
                                   M736 250 L736 430
                                   M736 250 l-4 9 h8 z M736 430 l-4 -9 h8 z" />
          <text class="dim__t" x="710" y="344" text-anchor="end">11.65 m</text>
        </g>

        <!-- ─── TITLE BLOCK ────────────────────────────────────────────── -->
        <g class="block">
          <path class="ln frame" d="M402 496 h344 v106 h-344 z M402 522 h344 M402 549 h344
                                     M402 576 h344 M596 522 v80" />
          <text class="block__k" x="412" y="514">GENERAL ARRANGEMENT · VARIABLE GEOMETRY</text>
          <text class="block__k" x="412" y="541">SWEEP  20° MIN / 68° MAX</text>
          <text class="block__v" x="606" y="541">SHEET 1 OF 1</text>
          <text class="block__k" x="412" y="568">SCALE  1:96</text>
          <text class="block__v" x="606" y="568">THIRD ANGLE</text>
          <text class="block__k" x="412" y="595">PRISM · COMPONENT LIBRARY</text>
          <text class="block__v" x="606" y="595">REV 70</text>
        </g>
      </g>

      <g class="notes">
        <g class="note" data-note="1">
          <path class="note__lead" d="M96 148 L100 96" />
          <circle class="note__dot" cx="96" cy="148" r="3.2" />
          <text class="note__n" x="108" y="78">01</text>
          <text class="note__t" x="108" y="94">radar · pulse-doppler</text>
        </g>
        <g class="note" data-note="2">
          <path class="note__lead" d="M296 104 L330 58" />
          <circle class="note__dot" cx="296" cy="104" r="3.2" />
          <text class="note__n" x="338" y="46">02</text>
          <text class="note__t" x="338" y="62">cockpit · tandem</text>
        </g>
        <g class="note" data-note="3">
          <path class="note__lead" d="M702 150 L716 190" />
          <circle class="note__dot" cx="702" cy="150" r="3.2" />
          <text class="note__n" x="746" y="188" text-anchor="end">03</text>
          <text class="note__t" x="746" y="204" text-anchor="end">engine · 2 × afterburning</text>
        </g>
        <g class="note" data-note="4">
          <path class="note__lead" d="M414 196 L470 232" />
          <circle class="note__dot" cx="414" cy="196" r="3.2" />
          <text class="note__n" x="478" y="230">04</text>
          <text class="note__t" x="478" y="246">hardpoint · 4 stations</text>
        </g>
        <g class="note" data-note="5">
          <path class="note__lead" d="M470 268 L360 232" />
          <circle class="note__dot" cx="470" cy="268" r="3.2" />
          <text class="note__n" x="352" y="220" text-anchor="end">05</text>
          <text class="note__t" x="352" y="236" text-anchor="end">wing · 20°–68° sweep</text>
        </g>
      </g>

      <g class="marks" aria-hidden="true">
        <path d="M14 14 h20 M14 14 v20 M746 14 h-20 M746 14 v20
                 M14 606 h20 M14 606 v-20 M746 606 h-20 M746 606 v-20" />
      </g>
    </svg>
  </figure>
</section>

<style>
  .hero {
    position: relative; isolation: isolate;
    display: grid; grid-template-columns: 1fr 1.08fr;
    gap: var(--s-l); align-items: center;
    padding: var(--s-2xs) 0 var(--s-m);
    /* The grid below bleeds past the well on purpose. Clip rather than hidden:
       clip does not create a scroll container, so sticky positioning survives.
       Without this the bleed widens the document and a phone zooms out. */
    overflow-x: clip;
  }

  /* Drafting paper: a real measuring grid under a real drawing, which is the
     only thing that earns a two-axis overlay. */
  .hero__field {
    /* Contained, not bleeding. A repeating grid fills whatever box it is given,
       so the -50vw bleed bought nothing and widened the document on a phone. */
    position: absolute; inset: 0; z-index: -1;
    background:
      repeating-linear-gradient(to right, color-mix(in oklab, var(--border) 34%, transparent) 0 1px, transparent 1px 28px),
      repeating-linear-gradient(to bottom, color-mix(in oklab, var(--border) 34%, transparent) 0 1px, transparent 1px 28px),
      repeating-linear-gradient(to right, color-mix(in oklab, var(--border) 72%, transparent) 0 1px, transparent 1px 140px),
      repeating-linear-gradient(to bottom, color-mix(in oklab, var(--border) 72%, transparent) 0 1px, transparent 1px 140px);
    mask-image:
      linear-gradient(to right, transparent, #000 18% 82%, transparent),
      linear-gradient(to bottom, transparent, #000 14% 78%, transparent);
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
  }

  /* The drawing is the hero. It spans the full well and the headline overlaps it,
     so the type sits on the plate rather than beside it. */
  .hero__plate { margin: 0; justify-self: end; width: 100%; max-width: 660px; }
  /* The viewBox contains the callout labels, so nothing needs to overflow.
     overflow: visible here let SVG text push the document wider on a phone. */
  .hero__plate { position: relative; }
  .hero__plate > svg { width: 100%; height: auto; overflow: hidden; display: block; }



  /* A blueprint is line work. Fills are there to separate one view's parts
     from the view behind it, never to shade the drawing, so they stay at the
     page or surface colour and the line carries the form. */
  .rules line { stroke: color-mix(in oklab, var(--accent) 38%, transparent); stroke-width: 1; fill: none; stroke-dasharray: 14 4 3 4; }

  .ln { fill: none; stroke: var(--text); stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round; }
  .hull    { fill: var(--bg); stroke-width: 1.9; }
  .glove,
  .nacelle { fill: var(--raised); }
  .wing .ln,
  .wingf   { fill: var(--surface); }
  .slat    { stroke: color-mix(in oklab, var(--accent) 55%, transparent); stroke-width: .8; fill: none; }
  .fin     { fill: color-mix(in oklab, var(--accent) 12%, var(--bg)); }
  .stab    { fill: var(--surface); }
  .nozzle  { fill: var(--accent); stroke: var(--accent); }
  .canopy  { fill: color-mix(in oklab, var(--accent) 20%, var(--bg)); }
  .radome  { fill: color-mix(in oklab, var(--accent) 20%, var(--bg)); }
  .pylon   { fill: var(--raised); }
  .detail  { stroke: color-mix(in oklab, var(--text) 42%, transparent); stroke-width: .9; }

  /* Dimension lines and the title block are drawn, not typeset, so they draw
     in with the rest of the sheet rather than appearing fully formed. */
  .dim     { stroke: color-mix(in oklab, var(--accent) 70%, transparent); stroke-width: 1; fill: color-mix(in oklab, var(--accent) 70%, transparent); }
  .dim__t  { fill: var(--accent); font-family: var(--mono); font-size: 10.5px; letter-spacing: .08em; text-anchor: middle; }
  .frame   { stroke: color-mix(in oklab, var(--text) 55%, transparent); stroke-width: 1; }
  .block__k, .block__v { font-family: var(--mono); font-size: 9.5px; letter-spacing: .1em; fill: var(--text-dim); }
  .block__k { fill: var(--text); }
  .cap     { font-family: var(--mono); font-size: 10px; letter-spacing: .18em; fill: var(--text-dim); }

  .note__lead { stroke: var(--text); stroke-width: 1; fill: none; }
  .note__dot  { fill: var(--accent); stroke: none; }
  .note__n    { fill: var(--accent); font-family: var(--mono); font-size: 11px; font-weight: 500; }
  .note__t    { fill: var(--text); font-size: 12.5px; font-weight: 500; }
  .marks path { stroke: var(--accent); stroke-width: 1.4; fill: none; }

  /* The wings pivot at their glove. Sweep is the aircraft's defining trait,
     so it is the animation rather than decoration on top of one. */
  .wing--stbd { transform-origin: 330px 308px; }
  .wing--port { transform-origin: 330px 352px; }

  .hero__say { display: grid; gap: var(--s-2xs); }

  .hero__say h1 {
    font-size: clamp(2.7rem, 5.6vw, 5.2rem);
    line-height: .88; letter-spacing: -0.042em;
    font-weight: 800;
  }
  /* The mask exists to hide the line before it slides up. Pad it and pull the
     padding back, so it clips vertical travel without clipping descenders —
     a tight line-height makes the line box shorter than the glyphs. */
  .hero__say h1 span {
    display: block; overflow: hidden;
    padding-block: 0.14em; margin-block: -0.14em;
  }
  .hero__say h1 i { display: block; font-style: normal; }
  .ln3 i { color: var(--accent); }

  .hero__lead {
    margin-top: var(--s-s); font-size: var(--f-1); line-height: var(--lh-lead);
    color: var(--text-dim); max-width: 44ch; text-wrap: pretty;
  }
  .hero__foot { display: grid; gap: var(--s-2xs); }

  .hero__meta {
    margin-top: var(--s-s); max-width: 52ch; text-wrap: balance;
    font-size: var(--f-n1); color: var(--text-dim); font-variant-numeric: tabular-nums;
  }
  .hero__meta b { color: var(--text); font-weight: 600; }

  /* Motion is driven by GSAP in src/scripts/motion.js, not from here.
     These are only the resting states it animates from and to. */
  .hero__say h1 span { overflow: hidden; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; }
    .hero__plate { justify-self: center; max-width: 480px; }
  }
</style>

<style is:global>
  /* These rules belong to the React island. Astro scopes a component's styles
     by stamping an attribute on the elements IN ITS OWN TEMPLATE, and the
     island's nodes are created by React at runtime, so a scoped rule misses
     every one of them — which is why the canvas first sized itself to the
     document instead of to the plate. Every selector here starts with .af. */
  .hero__plate { position: relative; }

  .af {
    position: absolute; inset: 0; z-index: 1;
    opacity: 0; transition: opacity 420ms ease;
    pointer-events: none;
  }
  .af--live { opacity: 1; }
  /* Hidden, not removed: it is still the printable drawing and the fallback. */
  .hero__plate:has(.af--live) > svg { opacity: 0; transition: opacity 420ms ease; }
  .af__canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .af__over { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .af__lead { stroke: var(--text); stroke-width: 1; }
  .af__dim line { stroke: var(--accent); stroke-width: 1; stroke-dasharray: 5 3; }
  .af__dim circle { fill: var(--accent); }

  .af__note, .af__span {
    position: absolute; margin: 0; transform: translate(0, -50%);
    white-space: nowrap; font-size: var(--f-n1); font-weight: 500; line-height: 1.2;
  }
  .af__note { max-width: 46%; overflow: hidden; text-overflow: ellipsis; }
  .af__note i { font-style: normal; font-family: var(--mono); font-size: var(--f-n2); color: var(--accent); }
  .af__note--end { transform: translate(-100%, -50%); }
  .af__span { left: 50%; bottom: 2px; top: auto; transform: translate(-50%, 0); text-align: center; }
  .af__span b { font-family: var(--mono); color: var(--accent); font-weight: 500; }
  .af__span span { font-family: var(--mono); font-size: var(--f-n2); color: var(--text-dim); }

  @media (prefers-reduced-motion: reduce) {
    .af, .hero__plate:has(.af--live) > svg { transition: none; }
  }
</style>
