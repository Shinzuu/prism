---
const { count, total } = Astro.props;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__field" aria-hidden="true"></div>

  <figure class="hero__plate">
    <svg viewBox="0 0 900 470" role="img" aria-label="Plan view of a variable-geometry fighter, wings sweeping from forward to aft">
      <g class="rules" aria-hidden="true">
        <line x1="450" y1="8" x2="450" y2="462" />
        <line x1="30" y1="252" x2="870" y2="252" />
        <circle cx="450" cy="252" r="204" />
        <circle cx="450" cy="252" r="126" />
      </g>

      <!-- wing gloves: the fixed root the sweeping panels pivot inside -->
      <g class="craft">
        <path class="ln glove" d="M472 206 L560 236 L566 262 L472 272 Z" />
        <path class="ln glove" d="M428 206 L340 236 L334 262 L428 272 Z" />

        <!-- sweeping panels, pivoting at the glove -->
        <g class="wing wing--stbd">
          <path class="ln" d="M556 234 L806 262 L826 276 L810 284 L560 276 Z" />
          <path class="ln slat" d="M566 240 L792 264" />
        </g>
        <g class="wing wing--port">
          <path class="ln" d="M344 234 L94 262 L74 276 L90 284 L340 276 Z" />
          <path class="ln slat" d="M334 240 L108 264" />
        </g>

        <!-- fuselage: long nose, flat pancake between the nacelles -->
        <path class="ln hull" d="M450 22
          C459 46 464 78 466 112 L469 160 L471 200
          L472 236 L474 286 L476 330
          L470 356 L466 392 L458 414 L452 438 L450 452
          L448 438 L442 414 L434 392 L430 356 L424 330
          L426 286 L428 236 L429 200 L431 160 L434 112
          C436 78 441 46 450 22 Z" />

        <!-- engine nacelles, set wide -->
        <path class="ln nacelle" d="M478 240 L512 250 L516 330 L508 392 L490 400 L476 330 Z" />
        <path class="ln nacelle" d="M422 240 L388 250 L384 330 L392 392 L410 400 L424 330 Z" />

        <!-- twin canted stabilisers -->
        <path class="ln fin" d="M486 300 L534 232 L548 238 L512 318 Z" />
        <path class="ln fin" d="M414 300 L366 232 L352 238 L388 318 Z" />

        <!-- stabilators -->
        <path class="ln stab" d="M492 356 L590 388 L600 400 L574 402 L490 378 Z" />
        <path class="ln stab" d="M408 356 L310 388 L300 400 L326 402 L410 378 Z" />

        <!-- nozzles -->
        <path class="ln nozzle" d="M482 392 L506 392 L500 416 L484 414 Z" />
        <path class="ln nozzle" d="M418 392 L394 392 L400 416 L416 414 Z" />

        <!-- tandem canopy -->
        <path class="ln canopy" d="M450 50 C461 62 465 88 464 120 L450 128 L436 120 C435 88 439 62 450 50 Z" />
        <path class="ln detail" d="M450 88 L450 128 M450 128 L450 200 M450 286 L450 392" />
        <path class="ln detail" d="M472 236 L560 250 M428 236 L340 250" />
        <path class="ln detail" d="M466 112 L472 206 M434 112 L428 206" />
      </g>

      <g class="marks" aria-hidden="true">
        <path d="M18 18 h22 M18 18 v22 M882 18 h-22 M882 18 v22
                 M18 452 h22 M18 452 v-22 M882 452 h-22 M882 452 v-22" />
      </g>

      <g class="sweepline" aria-hidden="true">
        <text x="450" y="466" text-anchor="middle" class="sweepline__t">sweep 20° — 68°</text>
      </g>
    </svg>
  </figure>

  <div class="hero__say">
    <h1 id="hero-title">
      <span class="ln1"><i>Components</i></span>
      <span class="ln2"><i>built to a</i></span>
      <span class="ln3"><i>tolerance.</i></span>
    </h1>
    <div class="hero__foot">
    <p class="hero__lead">
      Thirty pieces over ninety days. Plain HTML, CSS and JavaScript, every one recorded
      with the prompt that produced it, and not a single colour a machine did not derive.
    </p>
    <p class="hero__meta">
      <b>{count}</b> of {total} built · no dependencies · a literal colour fails the build
    </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto;
    padding: var(--s-s) 0 var(--s-l);
  }

  /* Drafting paper: a real measuring grid under a real drawing, which is the
     only thing that earns a two-axis overlay. */
  .hero__field {
    position: absolute; inset: 0 -50vw; z-index: -1;
    background:
      repeating-linear-gradient(to right, color-mix(in oklab, var(--border) 34%, transparent) 0 1px, transparent 1px 28px),
      repeating-linear-gradient(to bottom, color-mix(in oklab, var(--border) 34%, transparent) 0 1px, transparent 1px 28px),
      repeating-linear-gradient(to right, color-mix(in oklab, var(--border) 72%, transparent) 0 1px, transparent 1px 140px),
      repeating-linear-gradient(to bottom, color-mix(in oklab, var(--border) 72%, transparent) 0 1px, transparent 1px 140px);
    mask-image: linear-gradient(to bottom, #000 52%, transparent 94%);
  }

  /* The drawing is the hero. It spans the full well and the headline overlaps it,
     so the type sits on the plate rather than beside it. */
  .hero__plate { grid-area: 1 / 1; margin: 0; justify-self: center; width: min(100%, 640px); }
  .hero__plate svg { width: 100%; height: auto; overflow: visible; display: block; }

  .rules line, .rules circle { stroke: color-mix(in oklab, var(--accent) 45%, transparent); stroke-width: 1; fill: none; }
  .rules circle { stroke-dasharray: 2 9; }

  .ln { fill: none; stroke: var(--text); stroke-width: 2.1; stroke-linejoin: round; stroke-linecap: round; }
  .hull    { fill: var(--bg); stroke-width: 2.8; }
  .glove,
  .nacelle { fill: var(--raised); }
  .wing .ln { fill: var(--surface); }
  .slat    { stroke: color-mix(in oklab, var(--accent) 55%, transparent); stroke-width: .9; fill: none; }
  .fin     { fill: color-mix(in oklab, var(--accent) 22%, var(--bg)); stroke: var(--text); }
  .stab    { fill: var(--surface); }
  .nozzle  { fill: var(--accent); stroke: var(--accent); }
  .canopy  { fill: color-mix(in oklab, var(--accent) 34%, var(--bg)); stroke: var(--text); }
  .detail  { stroke: color-mix(in oklab, var(--text) 50%, transparent); stroke-width: 1.1; }
  .marks path { stroke: var(--accent); stroke-width: 1.4; fill: none; }
  .sweepline__t { fill: var(--text-dim); font-family: var(--mono); font-size: 11px; letter-spacing: .06em; }

  /* The wings pivot at their glove. Sweep is the aircraft's defining trait,
     so it is the animation rather than decoration on top of one. */
  .wing--stbd { transform-origin: 560px 252px; }
  .wing--port { transform-origin: 340px 252px; }

  .hero__say { grid-area: 2 / 1; display: grid; gap: var(--s-2xs); margin-top: calc(var(--s-2xl) * -1); }

  .hero__say h1 {
    font-size: clamp(3rem, 9.4vw, 7.4rem);
    line-height: .84; letter-spacing: -0.045em;
    font-weight: 800; font-stretch: 96%;
    text-wrap: balance; mix-blend-mode: multiply;
  }
  .hero__say h1 span { display: block; overflow: hidden; }
  .hero__say h1 i { display: block; font-style: normal; }
  .ln3 i { color: var(--accent); }

  .hero__lead {
    margin-top: var(--s-s); font-size: var(--f-1); line-height: var(--lh-lead);
    color: var(--text-dim); max-width: 46ch;
  }
  .hero__foot { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s-m); }

  .hero__meta {
    margin-top: var(--s-s); max-width: 30ch;
    font-size: var(--f-n1); color: var(--text-dim); font-variant-numeric: tabular-nums;
  }
  .hero__meta b { color: var(--text); font-weight: 600; }

  /* Motion is driven by GSAP in src/scripts/motion.js, not from here.
     These are only the resting states it animates from and to. */
  .hero__say h1 span { overflow: hidden; }

  @media (max-width: 880px) {
    .hero__say { margin-top: calc(var(--s-l) * -1); }
    .hero__foot { display: grid; gap: var(--s-2xs); }
  }
</style>
