---
/* Getting out of a page, and moving to the one beside it.

   Two presentations of the same three links. At the top of the document, a
   breadcrumb that says where you are and returns you to where you came from.
   At the bottom of a phone, a fixed pager, because a component page is several
   thousand pixels long and the masthead is at the far end of it.

   `back` is a real href so a cold load or a shared link still works; nav.js
   upgrades it to history.back() when there is history to go back through, which
   is what restores the library's scroll position and its filter. */
const {
  back = '/',
  backLabel = 'Library',
  crumbs = [],
  prev = null,
  next = null,
  pagerLabel = 'component'
} = Astro.props;
---
<nav class="pnav" aria-label="Breadcrumb">
  <a class="pnav__back" href={back} data-back>
    <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" fill="none"
      stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M8.5 2.5 4 7l4.5 4.5" />
    </svg>
    <span>{backLabel}</span>
  </a>
  {crumbs.map((c) => <span class="pnav__crumb">{c}</span>)}
</nav>

{(prev || next) && (
  <nav class="pager" aria-label={`Previous and next ${pagerLabel}`}>
    {prev
      ? <a class="pager__step" href={prev.href} rel="prev" data-nav-prev aria-label={`Previous: ${prev.label}`}>
          <svg width="16" height="16" viewBox="0 0 14 14" aria-hidden="true" fill="none"
            stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8.5 2.5 4 7l4.5 4.5" />
          </svg>
          <b>{prev.label}</b>
        </a>
      : <span class="pager__step pager__step--off" aria-hidden="true"></span>}

    <a class="pager__up" href={back} data-back aria-label={`Back to ${backLabel}`}>{backLabel}</a>

    {next
      ? <a class="pager__step pager__step--next" href={next.href} rel="next" data-nav-next aria-label={`Next: ${next.label}`}>
          <b>{next.label}</b>
          <svg width="16" height="16" viewBox="0 0 14 14" aria-hidden="true" fill="none"
            stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="m5.5 2.5 4.5 4.5-4.5 4.5" />
          </svg>
        </a>
      : <span class="pager__step pager__step--off" aria-hidden="true"></span>}
  </nav>
)}


<style>
  .pnav {
    display: flex; align-items: center; flex-wrap: wrap; gap: var(--s-2xs);
    margin-bottom: var(--s-s);
    font-family: var(--mono); font-size: var(--f-n2); color: var(--text-dim);
  }
  .pnav__back {
    display: inline-flex; align-items: center; gap: 5px;
    /* 44px of touch target without 44px of ink: the padding is negative on the
       left so the label still lines up with the column it sits above. */
    margin-left: -8px; padding: 9px 10px 9px 8px;
    border-radius: 999px; text-decoration: none; color: var(--text-dim);
  }
  .pnav__back:hover { color: var(--accent); background: color-mix(in oklab, var(--text) 7%, transparent); }
  .pnav__back svg { flex: none; }
  .pnav__crumb::before { content: "·"; margin-right: var(--s-2xs); }

  /* The pager is a phone control. On a wide screen the page already ends in a
     previous/next row, and a fixed bar would only cover the document. */
  .pager { display: none; }

  @media (max-width: 860px) {
    .pager {
      position: fixed; inset-inline: 0; bottom: 0; z-index: 44;
      display: grid; grid-template-columns: 1fr auto 1fr; align-items: stretch;
      gap: 1px;
      padding-bottom: env(safe-area-inset-bottom);
      background: color-mix(in oklab, var(--surface) 92%, transparent);
      backdrop-filter: blur(10px);
      border-top: var(--rule);
    }
    .pager__step, .pager__up {
      display: flex; align-items: center; gap: 6px;
      min-height: 48px; padding: 0 var(--s-2xs);
      text-decoration: none; color: var(--text-dim);
      font-size: var(--f-n2);
    }
    .pager__step b {
      font-weight: 450; color: var(--text);
      /* One line, always. A component called "Segmented control with overflow"
         must not push the middle button off the bar. */
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .pager__step--next { justify-content: flex-end; text-align: right; }
    .pager__step--off { pointer-events: none; }
    .pager__up {
      justify-content: center; padding-inline: var(--s-s);
      border-inline: var(--rule);
      font-family: var(--mono); color: var(--text);
    }
    .pager__step:active, .pager__up:active { background: color-mix(in oklab, var(--text) 8%, transparent); }

    /* The bar is fixed, so the document has to end above it, and the
       back-to-top button has to sit on top of it. */
    :global(body) { padding-bottom: calc(48px + env(safe-area-inset-bottom)); }
    :global(.totop) { bottom: calc(48px + env(safe-area-inset-bottom) + var(--s-2xs)); }
  }

</style>
